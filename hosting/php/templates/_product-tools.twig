{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/_product-tools.twig | Açıklama: Gerçek misafir favori, liste ve karşılaştırma eylemleri. #}
<div class="card-personal-tools"><button type="button" data-personal-action="favorite" data-product-id="{{ product.id }}" aria-pressed="false" aria-label="{{ locale=='tr'?'Favorilerime ekle veya kaldır':'Save or remove favourite' }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21 3 12C-3 5 7-1 12 6c5-7 15-1 9 6Z"/></svg></button><button type="button" data-list-product="{{ product.id }}" aria-label="{{ locale=='tr'?'Özel listeye kaydet':'Save to private list' }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v19l-6-4-6 4ZM9 9h6M12 6v6"/></svg></button><button type="button" data-personal-action="compare" data-product-id="{{ product.id }}" aria-pressed="false" aria-label="{{ locale=='tr'?'Ürünü karşılaştır':'Compare product' }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18V8m8 10V3m8 15v-5M2 21h20"/></svg></button></div>
