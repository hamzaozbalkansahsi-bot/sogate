{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/personal.twig | Açıklama: Hesapsız da kullanılabilen favori, özel liste ve karşılaştırma sayfaları. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container personal-page"><h1>{{ title }}</h1><nav class="personal-tabs" aria-label="{{ locale=='tr'?'Alışveriş listelerim':'My shopping lists' }}"><a href="{{ href('/favoriler') }}" {% if view=='favorites' %}aria-current="page"{% endif %}>{{ locale=='tr'?'Favorilerim':'Favourites' }}</a><a href="{{ href('/listeler') }}" {% if view=='lists' %}aria-current="page"{% endif %}>{{ locale=='tr'?'Listelerim':'My lists' }}</a><a href="{{ href('/karsilastir') }}" {% if view=='compare' %}aria-current="page"{% endif %}>{{ locale=='tr'?'Karşılaştır':'Compare' }}</a></nav>{% if not principal %}<p class="muted personal-privacy">{{ locale=='tr'?'Favorileriniz ve listeleriniz bu cihazdaki alışveriş oturumuna bağlıdır. Hesaba girişte aktarım için ayrıca seçim yapabilirsiniz.':'Your favourites and lists are linked to this device’s shopping session. You can choose whether to transfer them when you sign in.' }}</p>{% endif %}<p id="personal-status" class="form-message" role="status"></p><div id="personal-content" data-view="{{ view }}" data-list="{{ activeList.id??'' }}">{% include '_personal-workspace.twig' %}</div></section>{% endblock %}
