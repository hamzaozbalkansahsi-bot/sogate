{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/_personal-workspace.twig | Açıklama: Gerçek sahiplikli kayıtları güvenli sepet seçimine bağlayan özel sayfa parçası. #}
{% if view=='lists' %}<div class="personal-list-heading"><form data-personal-form="list-create" class="personal-create"><label>{{ locale=='tr'?'Yeni liste adı':'New list name' }}<input name="name" required maxlength="60" placeholder="{{ locale=='tr'?'Örneğin: Hediye fikirleri':'For example: Gift ideas' }}"></label><button class="button">{{ locale=='tr'?'Liste oluştur':'Create list' }}</button><p class="form-message" role="alert"></p></form><p class="small muted">{{ shopping.lists|length }}/20 {{ locale=='tr'?'liste':'lists' }}</p></div><nav class="personal-list-nav" aria-label="{{ locale=='tr'?'Özel listeler':'Private lists' }}">{% for list in shopping.lists %}<a href="{{ href('/listeler') }}?liste={{ list.id }}" {% if activeList and activeList.id==list.id %}aria-current="page"{% endif %}>{{ list.name }} <span>{{ list.items|length }}</span></a>{% endfor %}</nav>{% if activeList %}<div class="personal-list-heading"><h2>{{ activeList.name }}</h2><form data-personal-form="list-rename" class="personal-rename"><input type="hidden" name="listId" value="{{ activeList.id }}"><label class="sr-only" for="rename-list">{{ locale=='tr'?'Liste adı':'List name' }}</label><input id="rename-list" name="name" value="{{ activeList.name }}" required maxlength="60"><button class="button button-outline">{{ locale=='tr'?'Adını değiştir':'Rename' }}</button><p class="form-message" role="alert"></p></form><button class="text-button" type="button" data-remove-list="{{ activeList.id }}">{{ locale=='tr'?'Listeyi kaldır':'Remove list' }}</button></div>{% endif %}{% endif %}
{% if view=='compare' and products|length %}<label class="php-check compare-difference"><input type="checkbox" data-compare-different><span>{{ locale=='tr'?'Yalnız farkları göster':'Show differences only' }}</span></label><div class="comparison-scroll" tabindex="0" role="region" aria-label="{{ locale=='tr'?'Ürün karşılaştırma tablosu':'Product comparison table' }}"><table class="comparison-table"><caption class="sr-only">{{ locale=='tr'?'Gerçek ürün özellikleri; olmayan bilgi için çizgi gösterilir.':'Actual product details; missing information is shown with a dash.' }}</caption><thead><tr><th scope="col">{{ locale=='tr'?'Özellik':'Feature' }}</th>{% for product in products %}<th scope="col"><a href="{{ href('/urun/'~product.slug) }}"><img src="{{ asset(product.image) }}" alt="" width="150" height="160">{{ locale=='tr'?product.name:product.name_en }}</a><button class="text-button" type="button" data-personal-action="compare" data-product-id="{{ product.id }}" aria-pressed="true">{{ t('remove') }}</button></th>{% endfor %}</tr></thead><tbody>{% for row in comparison %}<tr data-comparison-equal="{{ row.different?'false':'true' }}"><th scope="row">{{ row.label }}</th>{% for value in row.values %}<td>{{ value }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div><button class="button button-outline" type="button" data-clear-compare>{{ locale=='tr'?'Karşılaştırmayı temizle':'Clear comparison' }}</button>
{% elseif view!='compare' and products|length %}<form data-personal-bulk data-source="{{ view=='favorites'?'favorites':'list' }}" data-list-id="{{ activeList.id??'' }}"><div class="personal-bulk-toolbar"><label class="php-check"><input type="checkbox" data-personal-select-all><span>{{ locale=='tr'?'Tümünü seç':'Select all' }}</span></label><button class="button">{{ locale=='tr'?'Seçilenleri sepete ekle':'Add selected to cart' }}</button><p class="small muted">{{ locale=='tr'?'Sepette bulunan seçeneğin adedi değişmez.':'Quantities already in the cart remain unchanged.' }}</p><p class="form-message" role="alert"></p></div><div class="product-grid personal-grid">{% for product in products %}<article class="product-card"><label class="personal-select php-check"><input type="checkbox" name="productIds" value="{{ product.id }}"><span>{{ locale=='tr'?'Seç':'Select' }}</span></label><a href="{{ href('/urun/'~product.slug) }}"><img src="{{ asset(product.image) }}" alt="" width="460" height="520"><h2>{{ locale=='tr'?product.name:product.name_en }}</h2></a><label class="personal-variant">{{ t('variant') }}<select data-variant-for="{{ product.id }}">{% if product.variants|length>1 %}<option value="">{{ locale=='tr'?'Seçeneğinizi belirleyin':'Choose an option' }}</option>{% endif %}{% for variant in product.variants %}<option value="{{ variant.id }}" {{ variant.available<1?'disabled':'' }}>{{ locale=='tr'?variant.name:variant.name_en }} · {{ variant.display_price_minor is not null?variant.display_price_minor|money(variant.display_currency):'—' }}</option>{% endfor %}</select></label><div class="personal-product-actions"><button class="text-button" type="button" {% if view=='favorites' %}data-personal-action="favorite"{% else %}data-remove-list-item{% endif %} data-product-id="{{ product.id }}" data-list-id="{{ activeList.id??'' }}" aria-pressed="true">{{ t('remove') }}</button><button class="text-button" type="button" data-list-product="{{ product.id }}">{{ locale=='tr'?'Listeye ekle':'Add to list' }}</button><button class="text-button" type="button" data-personal-action="compare" data-product-id="{{ product.id }}" aria-pressed="{{ product.id in shopping.compare?'true':'false' }}">{{ locale=='tr'?'Karşılaştır':'Compare' }}</button></div></article>{% endfor %}</div></form>
{% else %}<div class="card php-empty"><p>{{ view=='compare'?(locale=='tr'?'Karşılaştırmak için ürün kartlarından en fazla dört ürün seçin.':'Choose up to four products from the product cards to compare.'):(locale=='tr'?'Bu alanda henüz ürün yok. Ürünleri favorilerinize veya özel listenize ekleyebilirsiniz.':'There are no products here yet. Save products to your favourites or private list.') }}</p><a class="button" href="{{ href('/urunler') }}">{{ t('all') }}</a></div>{% endif %}
{% if unavailableCount %}<p class="muted small">{{ unavailableCount }} {{ locale=='tr'?'ürün artık yayında olmadığı için gösterilemiyor.':'products are unavailable because they are no longer published.' }}</p>{% endif %}
