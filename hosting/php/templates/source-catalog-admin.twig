{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/source-catalog-admin.twig | Açıklama: Tedarikçi kaynaklarının gerçek sayıları, ayrıntıları ve kontrollü katalog taslağı. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container source-review"><a class="text-link" href="{{ href('/yonetim') }}">Yönetime dön</a><h1>{{ title }}</h1><p class="muted">Kaynak verisi önce incelenir. Buradaki kayıtlar mağazada yayımlanmaz, depo stoğu oluşturmaz ve bayi alış fiyatı olarak kullanılmaz.</p><nav class="personal-tabs"><a href="{{ href('/yonetim/tedarikci-katalogu') }}">Aktarımlar</a><a href="{{ href('/yonetim/kategoriler') }}">Kategori ağacı</a><a href="{{ href('/yonetim/gorseller') }}">Görsel kütüphanesi</a></nav>
{% if record %}<article class="card source-detail"><h2>{{ record.title??'Başlığı henüz alınmamış kayıt' }}</h2><a class="text-link" href="{{ record.source_url }}" target="_blank" rel="noopener noreferrer">Kaynak kaydı aç</a><dl class="source-facts"><dt>İnceleme</dt><dd>{{ record.metadata_state=='parsed'?'Ayrıntılar alındı':(record.metadata_state=='access_required'?'Kaynak erişimi bekliyor':'Kontrol gerekiyor') }}</dd><dt>Kaynak SKU</dt><dd>{{ record.data.sku??'Belirtilmedi' }}</dd><dt>Kaynak perakende fiyatı</dt><dd>{{ record.data.quotedRetailMinor is defined and record.data.quotedRetailMinor is not null?record.data.quotedRetailMinor|money(record.data.quotedCurrency):'Alınamadı' }}</dd><dt>Bayi alış fiyatı</dt><dd>Doğrulanmadı</dd><dt>Tedarikçi stok miktarı</dt><dd>Doğrulanmadı</dd><dt>Görsel kullanım hakkı</dt><dd>Ayrıca onay gerekir</dd></dl>{% if record.data.description is defined %}<details><summary>Kaynak açıklamasını incele</summary><p class="source-description">{{ record.data.description }}</p></details>{% endif %}<div class="source-image-links">{% for image in record.data.images??[] %}<a href="{{ image }}" target="_blank" rel="noopener noreferrer">Kaynak görsel {{ loop.index }}</a>{% endfor %}</div></article>{% if record.kind=='product' and record.metadata_state=='parsed' and record.status=='review' %}<form class="card form-stack" data-api="/api/admin/source-catalog/draft" data-reload="true"><h2>İncelenmiş katalog taslağı oluştur</h2><input type="hidden" name="batchId" value="{{ record.batch_id }}"><input type="hidden" name="sourceKey" value="{{ record.source_key }}"><input type="hidden" name="key" data-command-key><div class="field-grid"><label>Ürün adı · Türkçe<input name="name" value="{{ record.title??'' }}" required maxlength="300"></label><label>Ürün adı · English<input name="nameEn" required maxlength="300"></label><label>İç stok kodu / SKU<input name="sku" value="{{ record.data.sku??'' }}" required maxlength="191"></label><label>Bağlantı adı<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*"></label><label>Kategori<select name="category" required>{% for c in catalogCategories %}<option value="{{ c.slug }}">{{ c.name }}</option>{% endfor %}</select></label><label>Seçenek adı<input name="variantName" required maxlength="300"></label><label>Satış fiyatı · kuruş<input type="number" name="priceMinor" min="1" required></label><label>Doğrulanmış alış maliyeti · kuruş<input type="number" name="costMinor" min="0" required></label></div><label>Kütüphaneden izinli ürün görseli yolu<input name="image" required></label><label>Görsel kullanım hakkı referansı<input name="rightsReference" required minlength="5" maxlength="2000"></label><label class="php-check"><input type="checkbox" name="rightsConfirmed" required><span>Seçtiğim görselin bu mağazada kullanım hakkını doğruladım.</span></label><p class="small muted">Taslakta stok bulunmaz. Ülke/ürün belgeleri ve gerçek gönderim koşulları ayrıca doğrulanmadan satışa açılmaz.</p><button class="button">Katalog taslağı oluştur</button><p class="form-message" role="alert"></p></form>{% elseif record.product_id %}<a class="text-link" href="{{ href('/yonetim/katalog') }}">Oluşturulan taslağı katalogda incele</a>{% endif %}
{% elseif listing %}<h2>{{ listing.batch.vendor }} · {{ listing.total }} kayıt</h2><form method="get" class="source-filter"><label>Ürün veya kategori ara<input name="q" maxlength="100" value="{{ listing.query }}"></label><label>Kayıt<select name="kind"><option value="">Tümü</option><option value="product" {{ listing.filters.kind|default('')=='product'?'selected':'' }}>Ürün</option><option value="category" {{ listing.filters.kind|default('')=='category'?'selected':'' }}>Kategori</option></select></label><button class="button">Ara</button></form><div class="table-scroll"><table><thead><tr><th>Adı</th><th>Tür</th><th>Ayrıntılar</th><th>İşlem</th></tr></thead><tbody>{% for row in listing.rows %}<tr><td>{{ row.title??'Kaynak adresi' }}</td><td>{{ row.kind=='product'?'Ürün':'Kategori' }}</td><td>{{ row.metadata_state=='parsed'?'Alındı':(row.metadata_state=='access_required'?'Erişim bekliyor':'Kontrol gerekiyor') }}</td><td><a class="text-link" href="{{ href('/yonetim/tedarikci-katalogu/'~listing.batch.id~'/'~row.source_key) }}">İncele</a></td></tr>{% endfor %}</tbody></table></div><nav class="pagination">{% if listing.page>1 %}<a href="?{{ listing.filters|merge({page:listing.page-1})|url_encode }}">Önceki</a>{% endif %}<span>{{ listing.page }}</span>{% if listing.page*40<listing.total %}<a href="?{{ listing.filters|merge({page:listing.page+1})|url_encode }}">Sonraki</a>{% endif %}</nav>
{% else %}{% include '_source-api.twig' %}<h2>Son tamamlanmış kataloglar</h2><div class="source-batches">{% for batch in batches %}<a class="card" href="{{ href('/yonetim/tedarikci-katalogu/'~batch.id) }}"><h2>{{ batch.vendor=='xshopum'?'xShopum':(batch.vendor=='liona'?'Liona':'Sistina') }}</h2><p><strong>{{ batch.product_count }}</strong> ürün · <strong>{{ batch.category_count }}</strong> kategori</p><p class="small muted">{{ batch.parsed_count }} kaydın ayrıntıları alındı{% if batch.access_required_count %} · {{ batch.access_required_count }} erişim bekliyor{% endif %}</p></a>{% else %}<article class="card"><p>Henüz katalog aktarımı yok.</p></article>{% endfor %}</div><form class="card form-stack narrow" method="post" enctype="multipart/form-data" action="{{ href('/api/admin/source-upload') }}"><h2>Toplanan kataloğu incelemeye al</h2><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="key" data-command-key><label>Tedarikçi<select name="vendor" required><option value="xshopum">xShopum</option><option value="liona">Liona</option><option value="sistina">Sistina</option></select></label><label>NDJSON veya sıkıştırılmış katalog · en fazla2 MB<input type="file" name="file" accept=".ndjson,.gz,application/gzip,application/x-ndjson" required></label><button class="button">İncelemeye aktar</button></form>{% endif %}</section>{% endblock %}
