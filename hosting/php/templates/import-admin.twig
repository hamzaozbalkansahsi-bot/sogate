{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/import-admin.twig | Açıklama: Sütun eşlemeli yükleme, hata önizleme ve denetimli taslak aktarım ekranı. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim/katalog') }}">Ürünler</a><h1>{{ title }}</h1>
{% if batch is null %}
<form class="card form-stack narrow" action="{{ basePath }}/api/admin/import-upload" method="post" enctype="multipart/form-data"><h2>Dosya seç ve incele</h2><input name="_csrf" type="hidden" value="{{ csrf }}"><label>Ürün dosyası<input name="file" type="file" accept=".csv,.xlsx" required></label><p>En fazla 2 MB, tek sayfa ve 500 ürün. CSV UTF-8 olmalıdır. Formül, makro ve dış bağlantı kabul edilmez. Aktarım ürünleri taslak oluşturur; stok girişi veya yayın onayı vermez.</p><a class="text-link" href="{{ href('/yonetim/ice-aktarim/sablon.csv') }}">CSV şablonunu indir</a><details><summary>Dosyadaki sütun başlıklarını eşleştir</summary>{% for name,label in columns %}<label>{{ label }}<input name="mapping[{{ name }}]" value="{{ label }}" maxlength="100"></label>{% endfor %}</details><button class="button">Önizlemeyi oluştur</button></form>
<div class="card php-table-wrap"><table><thead><tr><th>Dosya</th><th>Durum</th><th>Hata</th><th>Tarih</th></tr></thead><tbody>{% for r in rows %}<tr><td><a href="{{ href('/yonetim/ice-aktarim/'~r.id) }}">{{ r.file_name }}</a></td><td>{{ r.status=='committed'?'Aktarıldı':'Önizleme' }}</td><td>{{ r.error_count }}</td><td>{{ r.created_at }}</td></tr>{% else %}<tr><td colspan="4">Henüz içe aktarma kaydı yok.</td></tr>{% endfor %}</tbody></table></div>
{% else %}
<div class="card form-stack"><h2>{{ batch.file_name }}</h2><p>{{ batch.rows|length }} satır · {{ batch.error_count }} hata · {{ batch.status=='committed'?'Aktarım tamamlandı':'Önizleme' }}</p><p>Önizleme geçerliliği: {{ batch.expires_at }} UTC</p><a class="text-link" href="{{ href('/yonetim/ice-aktarim/'~batch.id~'/hatalar.csv') }}">Hata raporunu indir</a>{% if batch.status=='preview' and batch.error_count==0 %}<form class="form-stack" data-api="/api/admin/import" data-reload="true"><input name="id" type="hidden" value="{{ batch.id }}"><input name="idempotencyKey" type="hidden"><button class="button">Taslak ürünleri oluştur</button><p class="form-message" role="alert"></p></form>{% elseif batch.error_count>0 %}<p>Hataları dosyada düzeltip yeni önizleme oluşturun. Bu dosyadan ürün yazılmadı.</p>{% endif %}</div>
<div class="card php-table-wrap"><table><thead><tr><th>Satır</th><th>Stok kodu</th><th>Ürün</th><th>Fiyat</th><th>Kontrol</th></tr></thead><tbody>{% for r in batch.rows %}<tr><td>{{ r.line }}</td><td>{{ r.data.sku }}</td><td>{{ r.data.name }}</td><td>{{ r.data.price }}</td><td>{% for error in r.errors %}<p>{{ error|import_error }}</p>{% else %}Taslak oluşturmaya uygun{% endfor %}</td></tr>{% endfor %}</tbody></table></div>
{% endif %}</section>{% endblock %}
