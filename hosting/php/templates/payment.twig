{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/payment.twig | Açıklama: Yalnız test ortamındaki imzalı ödeme sonucu akışı. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container narrow"><div class="card form-stack"><p class="eyebrow">{{ order.number }}</p><h1>{{ t('test_payment') }}</h1><p>{{ t('test_payment_text') }}</p><p class="php-total">{{ order.total_minor|money(order.currency) }}</p>{% for outcome in ['succeeded','failed'] %}<form data-api="/api/payments/test"><input type="hidden" name="orderId" value="{{ order.id }}"><input type="hidden" name="trackingToken" value="{{ trackingToken }}"><input type="hidden" name="outcome" value="{{ outcome }}"><button class="button {{ outcome=='failed'?'button-outline':'' }} full">{{ outcome=='succeeded'?t('test_success'):t('test_failure') }}</button><p class="form-message" role="alert"></p></form>{% endfor %}</div></section>{% endblock %}
