{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/suppliers-admin.twig | Açıklama: Belge referanslı tedarikçi ve ayrı stok bildirimi yönetimi. #}
{% extends 'layout.twig' %}
{% macro select(name,label,rows,valueKey,labelKey) %}<label>{{ label }}<select name="{{ name }}" required>{% for row in rows %}<option value="{{ row[valueKey] }}">{{ row[labelKey] }}</option>{% endfor %}</select></label>{% endmacro %}
{% macro input(name,label,type='text',value='') %}<label>{{ label }}<input name="{{ name }}" type="{{ type }}" value="{{ value }}" required maxlength="500" {% if type=='number' %}min="0" max="1000000"{% endif %}></label>{% endmacro %}
{% block content %}
<section class="section container"><a class="text-link" href="{{ href('/yonetim') }}">Yönetim</a><h1>Tedarikçiler ve gönderim</h1><p>Tedarikçi bildirimi, kendi depomuzdaki fiziksel stoktan ayrı tutulur.</p>
<div class="php-account-grid">
<form class="card form-stack" data-api="/api/admin/suppliers" data-reload="true"><h2>Tedarikçi ekle</h2><input name="action" type="hidden" value="save">{{ _self.input('name','Tedarikçi unvanı') }}{{ _self.input('leadDays','Tedarik süresi (gün)','number','0') }}<label>İletişim e-postası<input name="email" type="email" maxlength="320"></label><button class="button">Tedarikçiyi kaydet</button><p class="form-message" role="alert"></p></form>
<form class="card form-stack" data-api="/api/admin/suppliers" data-reload="true"><h2>Gönderim onayları</h2><input name="action" type="hidden" value="profile">{{ _self.select('supplierId','Tedarikçi',data.suppliers,'id','name') }}{% for name,label in {'contractReference':'Sözleşme belge referansı','privacyReference':'Veri aktarım değerlendirme referansı','packagingReference':'Ambalaj koşulları referansı','returnReference':'İade operasyonu referansı'} %}{{ _self.input(name,label) }}{% endfor %}<label class="php-check"><input name="enabled" type="checkbox"><span>Belgeler incelendi; doğrudan sevki etkinleştir</span></label><button class="button">Onayları kaydet</button><p class="form-message" role="alert"></p></form>
<form class="card form-stack" data-api="/api/admin/suppliers" data-reload="true"><h2>Tedarikçi tarifesi</h2><input name="action" type="hidden" value="route">{{ _self.select('supplierId','Tedarikçi',data.suppliers,'id','name') }}{{ _self.select('country','Teslimat ülkesi',countries,'code','name') }}<label>Para birimi<select name="currency">{% for c in ['TRY','EUR','USD','GBP'] %}<option>{{ c }}</option>{% endfor %}</select></label>{{ _self.input('shipping','Müşteriye kargo bedeli','text','0,00') }}{{ _self.input('handling','İşletmeye işlem maliyeti','text','0,00') }}{{ _self.input('minDays','En erken hazırlık (gün)','number','1') }}{{ _self.input('maxDays','En geç hazırlık (gün)','number','3') }}{{ _self.input('carrier','Gerçek taşıyıcı') }}{{ _self.input('reference','Tarife belge referansı') }}<label class="php-check"><input name="approved" type="checkbox"><span>Bu rota ve tarife doğrulandı</span></label><button class="button">Tarifeyi kaydet</button><p class="form-message" role="alert"></p></form>
<form class="card form-stack" data-api="/api/admin/suppliers" data-reload="true"><h2>Stok bildirimi ve eşleme</h2><input name="action" type="hidden" value="offer">{{ _self.select('supplierId','Tedarikçi',data.suppliers,'id','name') }}{{ _self.select('variantId','Katalog stok kodu',variants,'id','sku') }}{{ _self.input('supplierSku','Gerçek dış stok kodu') }}<label>Para birimi<select name="currency">{% for c in ['TRY','EUR','USD','GBP'] %}<option>{{ c }}</option>{% endfor %}</select></label>{{ _self.input('cost','Birim alış maliyeti','text','0,00') }}{{ _self.input('quantity','Teyit edilmiş adet','number','0') }}{{ _self.input('safetyStock','Güvenlik payı','number','0') }}{{ _self.input('validUntil','Bildirimin geçerlilik sonu','datetime-local') }}{{ _self.input('reference','Stok teyit referansı') }}<label class="php-check"><input name="approved" type="checkbox"><span>Eşleme ve bildirim doğrulandı</span></label><p>Yeni bildirim, ödenmiş sipariş tahsislerini kendiliğinden kapatmaz.</p><button class="button">Bildirimi kaydet</button><p class="form-message" role="alert"></p></form>
<form class="card form-stack" data-api="/api/admin/suppliers" data-reload="true"><h2>Gönderim kaynağı</h2><input name="action" type="hidden" value="mode">{{ _self.select('variantId','Stok kodu',variants,'id','sku') }}<label>Kaynak<select name="mode"><option value="warehouse">Kendi depo</option><option value="dropship">Yalnız tedarikçi</option><option value="hybrid">Önce kendi depo</option></select></label><p>Seçim geçmiş siparişlerdeki kaynağı değiştirmez. Set ve lot takipli ürün için tedarikçi sevki kapalıdır.</p><button class="button">Kaynağı kaydet</button><p class="form-message" role="alert"></p></form>
<form class="card form-stack" data-api="/api/admin/suppliers" data-reload="true"><h2>Tahsis mutabakatı</h2><input name="action" type="hidden" value="reconcile"><input name="idempotencyKey" type="hidden"><label>Stok bildirimi<select name="offerId" required>{% for o in data.offers %}<option value="{{ o.id }}">{{ o.supplier }} · {{ o.sku }}</option>{% endfor %}</select></label><label>Yeni bildirimden düşüldüğü teyit edilen tahsis<select name="allocationId" required>{% for a in data.allocations %}<option value="{{ a.id }}">{{ a.number }} · {{ a.quantity }} adet</option>{% endfor %}</select></label>{{ _self.input('reference','Tedarikçi mutabakat belge referansı') }}<button class="button">Seçili tahsisi kapat</button><p class="form-message" role="alert"></p></form>
</div>
<h2>Tedarikçi gönderimleri</h2><div class="card php-table-wrap"><table><thead><tr><th>Sipariş</th><th>Tedarikçi</th><th>Durum</th><th>Dış sipariş teyidi</th></tr></thead><tbody>{% for g in data.groups %}<tr><td><a href="{{ href('/yonetim/tedarikci-paket/'~g.id) }}">{{ g.number }}</a></td><td>{{ g.supplier }}</td><td>{{ g.status|status }}</td><td>{{ g.external_order_reference??'Bekleniyor' }}</td></tr>{% else %}<tr><td colspan="4">Tedarikçiye ayrılan sipariş yok.</td></tr>{% endfor %}</tbody></table></div>
<h2>Stok bildirimleri</h2><div class="card php-table-wrap"><table><thead><tr><th>Tedarikçi</th><th>Stok kodu</th><th>Dış kod</th><th>Bildirilen</th><th>Güvenlik payı</th><th>Geçerlilik sonu</th><th>Alış maliyeti</th></tr></thead><tbody>{% for o in data.offers %}<tr><td>{{ o.supplier }}</td><td>{{ o.sku }}</td><td>{{ o.supplier_sku }}</td><td>{{ o.reported_quantity }}</td><td>{{ o.safety_stock }}</td><td>{{ o.valid_until }}</td><td>{{ o.cost_minor|money(o.currency) }}</td></tr>{% else %}<tr><td colspan="7">Tedarikçi bildirimi yok.</td></tr>{% endfor %}</tbody></table></div>
</section>
{% endblock %}
