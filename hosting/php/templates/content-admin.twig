{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/content-admin.twig | Açıklama: İçerik taslağı ve ayrı yayın komutları. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim') }}">Yönetime dön</a><h1>İçerik yönetimi</h1><div class="php-account-grid"><form class="card form-stack" data-api="/api/admin/content" data-reload="true"><h2>Yeni taslak</h2><label>Bölüm<select name="kind"><option value="guide">Rehber</option><option value="faq">Sık sorulan sorular</option><option value="collection">Koleksiyon</option><option value="hero">Ana kampanya</option><option value="contact">İletişim</option><option value="footer">Alt bilgi</option><option value="navigation">Menü</option></select></label><label>Dil<select name="locale"><option value="tr">Türkçe</option><option value="en">English</option><option value="de">Deutsch · Taslak</option><option value="ru">Русский · Taslak</option><option value="ar">العربية · Taslak</option></select></label><label>Bağlantı adı<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="120"></label><label>Başlık<input name="title" required maxlength="300"></label><label>Kısa açıklama<textarea name="summary" maxlength="2000"></textarea></label><label>Metin<textarea name="body" rows="7" maxlength="30000" required></textarea></label><button class="button">Taslağı kaydet</button><p class="form-message" role="alert"></p></form><form class="card form-stack" data-api="/api/admin/content" data-reload="true"><h2>Yayınla</h2><input type="hidden" name="action" value="publish"><label>Taslak<select name="id">{% for row in rows %}<option value="{{ row.id }}">{{ row.title }} · {{ row.locale }} · Sürüm {{ row.current_version }}</option>{% endfor %}</select></label><label>Yayın zamanı (isteğe bağlı)<input type="datetime-local" name="publishAt"></label><button class="button">Seçili sürümü yayımla</button><p class="form-message" role="alert"></p></form></div>
{% for row in rows %}<details class="card"><summary>{{ row.title }} · {{ row.locale }} · Sürüm {{ row.current_version }}</summary><form class="form-stack" data-api="/api/admin/content" data-reload="true"><input type="hidden" name="id" value="{{ row.id }}"><input type="hidden" name="kind" value="{{ row.kind }}"><input type="hidden" name="locale" value="{{ row.locale }}"><input type="hidden" name="slug" value="{{ row.slug }}"><label>Başlık<input name="title" value="{{ row.title }}" required maxlength="300"></label><label>Kısa açıklama<textarea name="summary" maxlength="2000">{{ row.summary }}</textarea></label><label>Metin<textarea name="body" rows="7" maxlength="30000">{{ row.body }}</textarea></label><button class="button button-outline">Yeni taslak sürümü kaydet</button><p class="form-message" role="alert"></p></form></details>{% endfor %}</section>{% endblock %}
