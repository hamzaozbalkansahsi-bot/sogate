{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/_personal-dialogs.twig | Açıklama: Liste kaydetme, açık aktarım ve kaldırma için erişilebilir uygulama pencereleri. #}
<a class="compare-tray" href="{{ href('/karsilastir') }}" hidden data-compare-tray>{{ locale=='tr'?'Karşılaştır':'Compare' }} <span data-shopping-count="compare">0</span>/4</a>
<dialog id="save-list-dialog" class="discovery-dialog personal-dialog" aria-labelledby="save-list-title"><div class="drawer-heading"><h2 id="save-list-title">{{ locale=='tr'?'Listeme kaydet':'Save to my list' }}</h2><button type="button" data-dialog-close aria-label="{{ t('close') }}">×</button></div><form id="save-list-form" class="form-stack"><label>{{ locale=='tr'?'Mevcut liste':'Existing list' }}<select name="listId"></select></label><label>{{ locale=='tr'?'Veya yeni liste adı':'Or a new list name' }}<input name="name" maxlength="60"></label><button class="button">{{ t('save') }}</button><p class="form-message" role="alert"></p></form></dialog>
<dialog id="remove-list-dialog" class="discovery-dialog personal-dialog" aria-labelledby="remove-list-title"><div class="drawer-heading"><h2 id="remove-list-title">{{ locale=='tr'?'Listeyi kaldır':'Remove list' }}</h2><button type="button" data-dialog-close aria-label="{{ t('close') }}">×</button></div><p>{{ locale=='tr'?'Yalnız bu özel liste kaldırılacak. Sepetiniz ve favorileriniz korunur.':'Only this private list will be removed. Your cart and favourites will be kept.' }}</p><button class="button" type="button" data-confirm-remove-list>{{ locale=='tr'?'Listeyi kaldır':'Remove list' }}</button><p class="form-message" role="alert"></p></dialog>
<dialog id="transfer-shopping-dialog" class="discovery-dialog personal-dialog" aria-labelledby="transfer-shopping-title"><div class="drawer-heading"><h2 id="transfer-shopping-title">{{ locale=='tr'?'Bu cihazdaki listeler':'Lists on this device' }}</h2><button type="button" data-dialog-close aria-label="{{ t('close') }}">×</button></div><div data-transfer-summary></div><label class="php-check"><input type="checkbox" id="transfer-shopping-consent"><span>{{ locale=='tr'?'Bu cihazdaki favori ve listeleri hesabıma aktarmak istiyorum.':'I want to transfer the favourites and lists on this device to my account.' }}</span></label><div class="personal-dialog-actions"><button class="button" type="button" data-confirm-transfer disabled>{{ locale=='tr'?'Hesabıma aktar':'Transfer to my account' }}</button><button class="button button-outline" type="button" data-decline-transfer>{{ locale=='tr'?'Aktarma':'Do not transfer' }}</button></div><p class="form-message" role="alert"></p></dialog>
