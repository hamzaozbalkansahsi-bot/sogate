{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/catalog.twig | Açıklama: Sunucu araması ve sayfalı gerçek ürün listesi. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><p class="eyebrow">SEXOGATE</p><div class="catalog-heading"><h1>{{ title }}</h1><button type="button" class="button button-outline catalog-filter-trigger" data-dialog-open="catalog-filter" aria-controls="catalog-filter" aria-expanded="false">{{ locale=='tr'?'Filtrele':'Filter' }}</button></div><form class="php-search" method="get"><label for="query">{{ t('search') }}</label><input id="query" name="q" value="{{ query }}" maxlength="100" type="search"><button class="button">{{ t('search') }}</button></form>
<div class="catalog-layout"><aside class="catalog-filter-panel">{% include '_catalog-filters.twig' %}</aside><div><div class="catalog-toolbar"><p>{{ catalog.total }} {{ locale=='tr'?'ürün':'products' }}</p><form method="get" class="catalog-sort">{% for key,value in filters %}{% if key not in ['sort','page'] %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endif %}{% endfor %}<label>{{ locale=='tr'?'Sırala':'Sort' }}<select name="sort" data-auto-submit>{% for key,label in {'recommended':locale=='tr'?'Önerilen sıralama':'Recommended','price-asc':locale=='tr'?'Fiyat: düşükten yükseğe':'Price: low to high','price-desc':locale=='tr'?'Fiyat: yüksekten düşüğe':'Price: high to low','name':locale=='tr'?'Ürün adı':'Product name'} %}<option value="{{ key }}" {{ (filters.sort??'recommended')==key?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label><noscript><button>{{ locale=='tr'?'Sırala':'Sort' }}</button></noscript></form></div>{% include '_cards.twig' with {products:catalog.rows} %}<nav class="php-pagination" aria-label="{{ locale=='tr'?'Sayfalar':'Pages' }}">{% if catalog.page>1 %}<a class="button button-outline" href="?{{ filters|merge({page:catalog.page-1})|url_encode }}">{{ t('previous') }}</a>{% endif %}{% if catalog.total>catalog.page*24 %}<a class="button button-outline" href="?{{ filters|merge({page:catalog.page+1})|url_encode }}">{{ t('next') }}</a>{% endif %}</nav></div></div>
<dialog id="catalog-filter" class="discovery-dialog catalog-mobile-filters" aria-labelledby="filter-title"><div class="drawer-heading"><h2 id="filter-title">{{ locale=='tr'?'Filtreler':'Filters' }}</h2><button type="button" data-dialog-close aria-label="{{ t('close') }}">×</button></div><div class="catalog-filter-panel">{% include '_catalog-filters.twig' %}</div></dialog></section>{% endblock %}
