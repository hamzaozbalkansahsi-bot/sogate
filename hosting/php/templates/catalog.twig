{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/catalog.twig | Açıklama: Sunucu araması ve sayfalı gerçek ürün listesi. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><p class="eyebrow">SEXOGATE</p><h1>{{ title }}</h1><form class="php-search" method="get"><label for="query">{{ t('search') }}</label><input id="query" name="q" value="{{ query }}" maxlength="100"><button class="button" type="submit">{{ t('search') }}</button></form>{% include '_cards.twig' with {products:catalog.rows} %}<nav class="php-pagination" aria-label="{{ locale=='tr'?'Sayfalar':'Pages' }}">{% if catalog.page>1 %}<a class="button button-outline" href="?page={{ catalog.page-1 }}&q={{ query|url_encode }}">{{ t('previous') }}</a>{% endif %}{% if catalog.total>catalog.page*24 %}<a class="button button-outline" href="?page={{ catalog.page+1 }}&q={{ query|url_encode }}">{{ t('next') }}</a>{% endif %}</nav></section>{% endblock %}
