{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/home.twig | Açıklama: NODENO vitrin/yan alan/kategori çemberi/ürün rafı ve gerçek rehber yapısı. #}
{% extends 'layout.twig' %}{% block content %}<div class="container home-page"><div class="home-vitrine"><section class="hero php-hero"><div class="hero-inner"><div class="hero-copy"><p class="eyebrow">SEXOGATE · {{ t('brand_line') }}</p><h1>{{ hero.title??t('hero') }}</h1><p class="hero-description">{{ hero.summary??t('hero_text') }}</p><a class="button button-light" href="{{ href('/urunler') }}">{{ t('discover') }} <span aria-hidden="true">↗</span></a></div><div class="php-hero-art" aria-hidden="true"><img src="{{ asset('/brand/app/liora-640.webp') }}" srcset="{{ asset('/brand/app/liora-640.webp') }} 640w, {{ asset('/brand/app/liora-1200.webp') }} 1200w" sizes="(max-width:700px) 80vw, 520px" alt="" width="640" height="640" fetchpriority="high"></div></div></section><aside class="home-campaigns" aria-label="{{ locale=='tr'?'Koleksiyondan seçkiler':'Collection highlights' }}">{% for product in products|slice(0,2) %}<a class="home-campaign" href="{{ href('/urun/'~product.slug) }}"><img src="{{ asset(product.image) }}" alt="" width="420" height="320"><div><p>{{ locale=='tr'?'Koleksiyondan':'From the collection' }}</p><h2>{{ locale=='tr'?product.name:product.name_en }}</h2></div></a>{% else %}<div class="home-campaign card"><h2>{{ t('collections') }}</h2><a class="text-link" href="{{ href('/koleksiyonlar') }}">{{ t('discover') }}</a></div>{% endfor %}</aside></div><section class="category-discovery"><div class="section-heading"><h2>{{ locale=='tr'?'Kategorileri keşfet':'Explore categories' }}</h2><a class="text-link" href="{{ href('/kategoriler') }}">{{ locale=='tr'?'Tüm kategoriler':'All categories' }}</a></div><div class="category-circles">{% for category in categoryRoots|slice(0,9) %}<a href="{{ href('/kategori/'~category.slug) }}"><span class="category-circle">{% if category.image %}<img src="{{ asset(category.image) }}" alt="" width="160" height="160" loading="lazy">{% else %}<span aria-hidden="true">{{ category.name|slice(0,1) }}</span>{% endif %}</span><strong>{{ locale=='tr'?category.name:category.name_en }}</strong></a>{% endfor %}</div></section><section class="home-shelf"><div class="section-heading"><h2>{{ t('selected') }}</h2><div class="shelf-actions"><a class="text-link" href="{{ href('/urunler') }}">{{ t('all') }}</a><button class="icon-button" type="button" data-shelf-step="-1" aria-label="{{ locale=='tr'?'Önceki ürünler':'Previous products' }}">‹</button><button class="icon-button" type="button" data-shelf-step="1" aria-label="{{ locale=='tr'?'Sonraki ürünler':'Next products' }}">›</button></div></div>{% include '_cards.twig' with {products:products} %}</section>{% if homeGuides|length %}<section class="home-guides"><div class="section-heading"><div><p class="eyebrow">{{ locale=='tr'?'Birlikte keşfedelim':'Explore together' }}</p><h2>{{ locale=='tr'?'Seçimlerinize eşlik eden rehberler':'Guides for your choices' }}</h2></div><a class="text-link" href="{{ href('/blog') }}">Blog</a></div><div class="home-guide-grid">{% for entry in homeGuides %}<a class="home-guide" href="{{ href('/blog/'~entry.slug) }}">{% if entry.cover %}<img src="{{ asset(entry.cover) }}" width="450" height="300" alt="" loading="lazy">{% endif %}<div><p class="eyebrow">{{ entry.metadata.topic??t('guide') }}</p><h3>{{ entry.title }}</h3><p>{{ entry.summary }}</p><span class="text-link">{{ locale=='tr'?'Rehberi oku':'Read guide' }}</span></div></a>{% endfor %}</div></section>{% endif %}{% if homeCollections|length %}<section class="home-collections"><div class="section-heading"><h2>{{ t('collections') }}</h2><a class="text-link" href="{{ href('/koleksiyonlar') }}">{{ t('all') }}</a></div><div class="home-guide-grid">{% for entry in homeCollections|slice(0,3) %}<a class="card" href="{{ href('/koleksiyon/'~entry.slug) }}"><h3>{{ entry.title }}</h3><p>{{ entry.summary }}</p></a>{% endfor %}</div></section>{% endif %}<section class="home-editorial"><p class="eyebrow">SEXOGATE</p><h2>{{ locale=='tr'?'Yakınlığı yeniden tanımla.':'Redefine closeness.' }}</h2><a class="button button-outline" href="{{ href('/rehber') }}">{{ t('guide') }}</a></section></div>{% endblock %}
