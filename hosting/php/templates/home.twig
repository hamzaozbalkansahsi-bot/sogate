{% extends 'layout.twig' %}{% block content %}
<section class="hero php-hero"><div class="container hero-inner"><div class="hero-copy"><p class="eyebrow">SEXOGATE · {{ t('brand_line') }}</p><h1>{{ hero.title??t('hero') }}</h1><p class="hero-description">{{ hero.summary??t('hero_text') }}</p><a class="button button-light" href="{{ href('/urunler') }}">{{ t('discover') }} <span aria-hidden="true">↗</span></a></div><div class="php-hero-art" aria-hidden="true"><img src="{{ asset('/brand/app/liora-640.webp') }}" srcset="{{ asset('/brand/app/liora-640.webp') }} 640w, {{ asset('/brand/app/liora-1200.webp') }} 1200w" sizes="(max-width: 640px) 70vw, 530px" alt="" width="640" height="640" fetchpriority="high"></div></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">SEXOGATE</p><h2>{{ t('selected') }}</h2></div><a class="text-link" href="{{ href('/urunler') }}">{{ t('all') }} ↗</a></div>{% include '_cards.twig' with {products:products} %}</section>
<section class="section php-soft"><div class="container php-editorial"><p class="eyebrow">{{ t('brand_line') }}</p><h2>{{ locale=='tr'?'Yakınlığı yeniden tanımla.':'Redefine closeness.' }}</h2><a class="button button-outline" href="{{ href('/rehber') }}">{{ t('guide') }}</a></div></section>
{% endblock %}
