{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/reset.twig | Açıklama: Sunucu loguna URL token'ı yazdırmadan hesap doğrulama/parola formu. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container narrow"><form class="card form-stack" data-api="{{ verifyEmail?'/api/auth/verify':'/api/auth/reset' }}" data-next="{{ href('/hesap') }}" id="token-form"><h1>{{ title }}</h1><input name="token" type="hidden">{% if not verifyEmail %}<label>{{ t('password') }}<input name="password" type="password" required minlength="12" maxlength="128" autocomplete="new-password"></label>{% endif %}<button class="button">{{ verifyEmail?t('verify'):t('reset') }}</button><p class="form-message" role="alert"></p></form></section>{% endblock %}
