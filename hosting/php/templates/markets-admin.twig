{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/markets-admin.twig | Açıklama: Ülke incelemeleri, fiyat ve uygunluk kayıtlarının yetkili yönetimi. #}
{% extends 'layout.twig' %}
{% macro country(countries) %}<label>Ülke<select name="country" required>{% for c in countries %}<option value="{{ c.code }}">{{ c.name }} ({{ c.code }})</option>{% endfor %}</select></label>{% endmacro %}
{% macro variant(variants) %}<label>Stok kodu<select name="variantId" required>{% for v in variants %}<option value="{{ v.id }}">{{ v.sku }} · {{ v.name }}</option>{% endfor %}</select></label>{% endmacro %}
{% macro currency(name) %}<label>Para birimi<select name="{{ name }}"><option>TRY</option><option>EUR</option><option>USD</option><option>GBP</option></select></label>{% endmacro %}
{% macro submit(label) %}<button class="button">{{ label }}</button><p class="form-message" role="alert"></p>{% endmacro %}
{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim') }}">Yönetime dön</a><h1>{{ title }}</h1><nav class="php-tabs" aria-label="Ülke ve fiyat yönetimi">{% if principal.role=='admin' %}<a href="{{ href('/yonetim/pazarlar') }}">Ülkeler ve vergi</a><a href="{{ href('/yonetim/uygunluk') }}">Ürün uygunluğu</a>{% endif %}<a href="{{ href('/yonetim/fiyatlar') }}">Fiyat listeleri</a></nav>
{% if section=='prices' %}
<form class="card form-stack" data-api="/api/admin/markets" data-reload="true"><h2>Fiyat kaydet</h2><input type="hidden" name="action" value="price">{{ _self.variant(variants) }}{{ _self.currency('currency') }}<label>Satış fiyatı<input name="amount" inputmode="decimal" required placeholder="149,50"></label><label>Son geçerlilik (isteğe bağlı)<input name="validUntil" type="datetime-local"></label>{{ _self.submit('Fiyatı kaydet') }}</form>
<div class="table-wrap"><table><caption>Kayıtlı fiyatlar · en fazla 200 kayıt</caption><thead><tr><th>Stok kodu</th><th>Fiyat</th><th>Başlangıç</th><th>Bitiş</th></tr></thead><tbody>{% for row in data.prices %}<tr><td>{{ row.sku }}</td><td>{{ row.amount_minor|money(row.currency) }}</td><td>{{ row.valid_from }}</td><td>{{ row.valid_until??'Süresiz' }}</td></tr>{% else %}<tr><td colspan="4">Henüz fiyat kaydı yok.</td></tr>{% endfor %}</tbody></table></div>
{% elseif section=='markets' %}
<p>Ülke koşulları değiştiğinde önceki incelemeler geçersiz olur. Kayıt oluşturmak satış izni vermez; altı güncel inceleme ve checkout uygunluğu ayrıca denetlenir.</p>
<form class="card form-stack" data-api="/api/admin/markets" data-reload="true"><h2>Ülke koşulları</h2><input type="hidden" name="action" value="country"><label>İki harfli ülke kodu<input name="code" pattern="[A-Z]{2}" maxlength="2" required></label><label>Ülke adı<input name="name" maxlength="200" required></label>{{ _self.currency('currency') }}<label>Kargo bedeli<input name="shipping" inputmode="decimal" required></label><label>Teslim koşulu<select name="deliveryTerm"><option>DAP</option><option>DDP</option></select></label><label>Yaş kontrolü<select name="ageMethod"><option value="unconfigured">Henüz belirlenmedi</option><option value="declaration">Yaş beyanı</option><option value="provider_required">Doğrulama servisi gerekli</option></select></label><label>Saat dilimi<input name="timeZone" required placeholder="Europe/Istanbul"></label><label>Kısıtlar<textarea name="restrictions" maxlength="4000"></textarea></label>{{ _self.submit('Koşulları kaydet') }}</form>
<form class="card form-stack" data-api="/api/admin/markets" data-reload="true"><h2>İnceleme kaydı</h2><input type="hidden" name="action" value="review">{{ _self.country(countries) }}<label>İnceleme<select name="gate">{% for key,label in {'product':'Ürün satışı','age':'Yaş kontrolü','payment':'Ödeme kabulü','shipping':'Taşıma','tax':'Vergi ve gümrük','legal':'Hukuk'} %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></label><label>Kaynak / belge referansı<input name="reference" minlength="5" maxlength="1000" required></label><label>Son kontrol tarihi<input name="validUntil" type="datetime-local" required></label><label class="php-check"><input type="checkbox" name="approved"><span>İnceleme doğrulandı</span></label>{{ _self.submit('İncelemeyi kaydet') }}</form>
{% for row in data.countries %}<article class="card"><h2>{{ row.name }} · {{ row.code }}</h2><p>{{ row.currency }} · {{ row.enabled?'Satışa açık':'Satışa kapalı' }} · Koşul sürümü {{ row.review_generation }}</p><form class="form-stack" data-api="/api/admin/markets" data-reload="true"><input type="hidden" name="action" value="enable"><input type="hidden" name="country" value="{{ row.code }}"><label class="php-check"><input type="checkbox" name="enabled" {{ row.enabled?'checked':'' }}><span>Bu ülkeye satışı aç</span></label>{{ _self.submit('Satış durumunu güncelle') }}</form></article>{% endfor %}
<form class="card form-stack" data-api="/api/admin/markets" data-reload="true"><h2>Vergi kuralı</h2><input type="hidden" name="action" value="tax">{{ _self.country(countries) }}<label>Kapsam<select name="kind"><option value="goods">Ürün</option><option value="shipping">Kargo</option></select></label><label>Ürün vergi sınıfı<input name="productClass" maxlength="100"></label><label>Vergi yüzdesi<input name="ratePercent" inputmode="decimal" required></label><label>Yürürlük başlangıcı<input name="validFrom" type="datetime-local" required></label><label>Yürürlük sonu<input name="validUntil" type="datetime-local"></label><label>Resmî kaynak / inceleme referansı<input name="reference" minlength="5" required></label>{{ _self.submit('Vergi kuralını kaydet') }}</form>
<div class="table-wrap"><table><caption>Son 100 ürün vergi kuralı</caption><thead><tr><th>Ülke</th><th>Sınıf</th><th>Oran (baz puan)</th><th>Yürürlük</th></tr></thead><tbody>{% for row in data.taxes %}<tr><td>{{ row.country }}</td><td>{{ row.product_class }}</td><td>{{ row.rate_bps }}</td><td>{{ row.valid_from }} – {{ row.valid_until??'Süresiz' }}</td></tr>{% else %}<tr><td colspan="4">Henüz kural yok.</td></tr>{% endfor %}</tbody></table></div>
{% else %}
<p>Belge ve taşıyıcı kayıtları gerçek kaynaklarıyla incelenir. Belge kaydı ürün yayın onayı yerine geçmez. Adres profilleri sürümlenir ve ayrıca onaylanır.</p>
<form class="card form-stack" data-api="/api/admin/compliance" data-reload="true"><h2>SKU için belge gereksinimi</h2><input type="hidden" name="action" value="eligibility">{{ _self.variant(variants) }}{{ _self.country(countries) }}<label>Belge türü (gerekiyorsa)<input name="requiredDocumentKind" pattern="[a-z0-9-]{1,100}"></label><label>İnceleme kaynağı<input name="reference" minlength="5" required></label>{{ _self.submit('Gereksinimi kaydet') }}</form>
<form class="card form-stack" data-api="/api/admin/compliance" data-reload="true"><h2>Ürün belgesi kaydet</h2><input type="hidden" name="action" value="document">{{ _self.variant(variants) }}{{ _self.country(countries) }}<label>Belge türü<input name="kind" pattern="[a-z0-9-]{1,100}" required></label><label>Kapsanan model<input name="modelReference" maxlength="300" required></label><label>Belge referansı<input name="reference" minlength="5" required></label><label>Geçerlilik başlangıcı<input name="validFrom" type="date" required></label><label>Geçerlilik sonu<input name="validUntil" type="date"></label>{{ _self.submit('Belgeyi taslak kaydet') }}</form>
{% for row in data.documents %}<article class="card"><h2>{{ row.sku }} · {{ row.kind }}</h2><p>{{ row.country }} · {{ row.reference }} · {{ row.model_reference }} · Sürüm {{ row.version }} · {{ row.reviewed?'İncelendi':'Onaylı değil' }}</p><form class="form-stack" data-api="/api/admin/compliance" data-reload="true"><input type="hidden" name="id" value="{{ row.id }}"><label>İşlem<select name="action"><option value="review-document">Son sürümü onayla</option><option value="revoke-document">Onayı geri çek</option></select></label><label>İnceleme / gerekçe<input name="reference" minlength="5" required></label>{{ _self.submit('İncelemeyi kaydet') }}</form></article>{% endfor %}
<form class="card form-stack" data-api="/api/admin/compliance" data-reload="true"><h2>Taşıyıcı kabulü</h2><input type="hidden" name="action" value="carrier">{{ _self.variant(variants) }}{{ _self.country(countries) }}<label>Taşıyıcı<input name="carrier" minlength="2" maxlength="191" required></label><label>Kabul belgesi referansı<input name="reference" minlength="5" required></label><label>Geçerlilik sonu<input name="validUntil" type="datetime-local" required></label><label class="php-check"><input type="checkbox" name="accepted"><span>Taşıyıcı SKU/modeli kabul ediyor</span></label>{{ _self.submit('Kabulü kaydet') }}</form>
{% for row in data.carriers %}<article class="card"><p>{{ row.sku }} · {{ row.country }} · {{ row.carrier }} · {{ row.accepted?'Kabul edildi':'Kabul edilmedi' }} · {{ row.valid_until }}</p></article>{% endfor %}
{% for row in data.profiles %}<article class="card"><h2>{{ row.country }} adres profili · Sürüm {{ row.version }}</h2><p>{{ row.status|status }} · {{ row.reference }}</p>{% if row.status=='draft' %}<form data-api="/api/admin/compliance" data-reload="true"><input type="hidden" name="action" value="approve-address"><input type="hidden" name="id" value="{{ row.id }}">{{ _self.submit('Adres profilini onayla') }}</form>{% endif %}</article>{% endfor %}
{% endif %}</section>{% endblock %}
