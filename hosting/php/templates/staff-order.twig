{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/staff-order.twig | Açıklama: Gerçek siparişe bağlı depo hazırlama ve sevk ekranı. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim/siparisler') }}">Siparişlere dön</a><p class="eyebrow">{{ detail.number }}</p><h1>Sipariş işlemleri</h1><p>{{ detail.status|status }}</p>{% if detail.address is defined %}<article class="card"><h2>Teslimat adresi</h2>{% for key,value in detail.address %}{% if key in ['fullName','phone','line1','city','postalCode','country'] %}<p>{{ value }}</p>{% endif %}{% endfor %}</article>{% endif %}
<div class="php-account-grid"><article class="card"><h2>Ürünler</h2>{% for item in detail.items %}<p>{{ item.name }} · {{ item.sku }} · {{ item.quantity }} adet</p>{% endfor %}</article>{% if principal.role in ['admin','warehouse'] and detail.status in ['confirmed','partially_shipped'] %}<form class="card form-stack" data-api="/api/admin/fulfillment" data-reload="true"><h2>Paket hazırlığı</h2><input type="hidden" name="orderId" value="{{ detail.id }}"><input type="hidden" name="action" value="prepare"><input type="hidden" name="idempotencyKey"><label>Depodan hazırlanacak ürün<select name="variantId">{% for item in detail.items %}{% if item.fulfillment_source=='warehouse' %}<option value="{{ item.variant_id }}">{{ item.sku }} · {{ item.name }}</option>{% endif %}{% endfor %}</select></label><label>Adet<input type="number" name="quantity" min="1" max="99" required></label><button class="button">Paket hazırlığını aç</button><p class="form-message" role="alert"></p></form>{% endif %}</div>
{% for task in detail.tasks %}<article class="card form-stack"><h2>Paket {{ loop.index }} · {{ task.status|status }}</h2>{% for item in task.items %}<p>{{ item.sku }} · {{ item.picked_quantity }}/{{ item.quantity }} toplandı · {{ item.packed_quantity }}/{{ item.quantity }} paketlendi</p>{% endfor %}{% if task.status in ['picking','packing'] and principal.role in ['admin','warehouse'] %}<form class="form-stack" data-api="/api/admin/fulfillment" data-reload="true"><input type="hidden" name="taskId" value="{{ task.id }}"><input type="hidden" name="action" value="scan"><input type="hidden" name="phase" value="{{ task.status=='picking'?'pick':'pack' }}"><input type="hidden" name="idempotencyKey"><label>{{ task.status=='picking'?'Toplanan ürün kodu':'Paketlenen ürün kodu' }}<input name="barcode" required autocomplete="off"></label><label>Okunan adet<input type="number" name="quantity" min="1" max="99" value="1" required></label><button class="button">{{ task.status=='picking'?'Toplamayı doğrula':'Paketlemeyi doğrula' }}</button><p class="form-message" role="alert"></p></form>{% elseif task.status=='packed' and principal.role in ['admin','warehouse'] %}<form class="form-stack" data-api="/api/admin/fulfillment" data-reload="true"><input type="hidden" name="taskId" value="{{ task.id }}"><input type="hidden" name="action" value="ship"><input type="hidden" name="idempotencyKey"><label>Gerçek taşıyıcı<input name="carrier" minlength="2" maxlength="100" required></label><label>Taşıyıcının takip numarası<input name="trackingNumber" minlength="3" maxlength="200" required></label><button class="button">Sevkiyatı kaydet</button><p class="form-message" role="alert"></p></form>{% endif %}</article>{% endfor %}
{% for shipment in detail.shipments %}<article class="card"><h2>{{ shipment.carrier }}</h2><p>{{ shipment.tracking_number }}</p><p>{{ shipment.status|status }}</p></article>{% endfor %}</section>{% endblock %}
