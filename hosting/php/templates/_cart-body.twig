{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/_cart-body.twig | Açıklama: Seçili satır, varyant ve gerçek sunucu toplamıyla güncellenen sepet bölümü. #}
<div id="cart-content" data-revision="{{ cart.revision }}">{% if cart.items|length %}<div class="cart-selection-toolbar"><p>{{ cart.count }} {{ locale=='tr'?'adet ürün':'items' }} · {{ cart.selectedCount }} {{ locale=='tr'?'seçili satır':'selected lines' }}</p><button type="button" data-cart-select-all>{{ locale=='tr'?'Tümünü seç':'Select all' }}</button><button type="button" data-cart-remove-selected>{{ locale=='tr'?'Seçilenleri kaldır':'Remove selected' }}</button><button type="button" data-cart-clear>{{ locale=='tr'?'Sepeti boşalt':'Clear cart' }}</button></div><div class="php-checkout-grid"><div>{% for item in cart.items %}<article class="card php-cart-row" data-cart-line="{{ item.variantId }}"><label class="cart-line-select"><input type="checkbox" data-cart-selection value="{{ item.variantId }}" {{ item.selected?'checked':'' }}><span class="sr-only">{{ locale=='tr'?'Ürünü seç':'Select item' }}: {{ locale=='en'?item.productNameEn:item.productName }}</span></label><a href="{{ href('/urun/'~item.slug) }}" aria-label="{{ locale=='en'?item.productNameEn:item.productName }}"><img src="{{ asset(item.image) }}" alt="" width="100" height="110"></a><div class="cart-line-details"><h2><a href="{{ href('/urun/'~item.slug) }}">{{ locale=='en'?item.productNameEn:item.productName }}</a></h2>{% if item.options|length>1 %}<label>{{ t('variant') }}<select data-cart-variant data-source="{{ item.variantId }}">{% for option in item.options %}<option value="{{ option.id }}" {{ option.id==item.variantId?'selected':'' }}>{{ locale=='en'?option.name_en:option.name }} · {{ option.price_minor|money(option.currency) }}</option>{% endfor %}</select></label>{% else %}<p>{{ locale=='en'?item.variantNameEn:item.variantName }}</p>{% endif %}<p class="price">{{ item.priceMinor|money }}</p><form data-cart-quantity class="php-inline"><input type="hidden" name="variantId" value="{{ item.variantId }}"><label>{{ t('quantity') }}<span class="quantity-control"><button type="button" data-cart-step="-1" aria-label="{{ locale=='tr'?'Adedi azalt':'Decrease quantity' }}">−</button><input name="quantity" type="number" value="{{ item.quantity }}" min="1" max="99" inputmode="numeric" required><button type="button" data-cart-step="1" aria-label="{{ locale=='tr'?'Adedi artır':'Increase quantity' }}">+</button></span></label><button class="button button-outline" type="submit">{{ t('update') }}</button><button class="text-link" type="button" data-cart-remove="{{ item.variantId }}">{{ t('remove') }}</button></form>{% if item.available<item.quantity %}<p class="form-message">{{ locale=='tr'?'Bu adet şu anda stokta bulunmuyor. Adedi güncelleyin.':'This quantity is currently unavailable. Update the quantity.' }}</p>{% endif %}</div><strong class="cart-line-total">{{ (item.priceMinor*item.quantity)|money }}</strong></article>{% endfor %}</div><aside class="card cart-summary"><h2>{{ locale=='tr'?'Sipariş özeti':'Order summary' }}</h2><div class="php-summary-row"><span>{{ t('subtotal') }}</span><strong data-cart-subtotal>{{ cart.subtotalMinor|money }}</strong></div><p class="small muted">{{ locale=='tr'?'Yalnız seçili ürünler siparişe aktarılır. Teslimat ve dahil vergi ödeme öncesi gösterilir.':'Only selected items proceed to checkout. Delivery and included tax are shown before payment.' }}</p>{% if cart.selectedCount>0 %}<a class="button full" href="{{ href('/odeme') }}">{{ t('checkout') }}</a>{% else %}<p>{{ locale=='tr'?'Devam etmek için en az bir ürün seçin.':'Select at least one item to continue.' }}</p>{% endif %}<a class="text-link" href="{{ href('/urunler') }}">{{ t('continue') }}</a></aside></div>{% else %}<div class="card php-empty"><h2>{{ t('empty_cart') }}</h2><a class="button" href="{{ href('/urunler') }}">{{ t('continue') }}</a></div>{% endif %}</div>
