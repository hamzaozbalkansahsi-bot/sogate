{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/information.twig | Açıklama: Ayrı hukuk, iletişim ve gezilebilir site haritası. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container information-page"><p class="eyebrow">SEXOGATE</p><h1>{{ title }}</h1>
{% if section=='legal' %}
{% if document.draft %}<aside class="document-status" aria-label="{{ locale=='tr'?'Belge durumu':'Document status' }}"><strong>{{ locale=='tr'?'İnceleme taslağı':'Draft for review' }}</strong><p>{{ locale=='tr'?'Satıcı/veri sorumlusu bilgileri ve yetkili hukuk incelemesi tamamlanmadan bu metin yürürlüğe girmez. Test alanında gerçek tahsilat yapılmaz.':'This draft is not effective until seller/controller details and authorised legal review are complete. No real charge is made in this test store.' }}</p></aside>{% else %}<p class="document-status">{{ locale=='tr'?'Yürürlükteki sürüm':'Effective version' }}: {{ document.version }}</p>{% endif %}
<div class="information-prose">{% if document.body %}<div>{{ document.body|nl2br }}</div>{% endif %}{% for part in document.sections %}<section><h2>{{ part.title }}</h2>{% for paragraph in part.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</section>{% endfor %}</div><p><a class="text-link" href="{{ href('/iletisim') }}">{{ locale=='tr'?'Sorularınız için bize ulaşın':'Contact us with your questions' }}</a></p>
{% elseif section=='contact' %}<div class="contact-panel"><h2>{{ locale=='tr'?'Bize yazın':'Write to us' }}</h2><p>{{ locale=='tr'?'Ürünler, siparişiniz veya iade süreciyle ilgili sorularınız için e-posta ile ulaşabilirsiniz.':'Contact us by email about products, your order or the returns process.' }}</p><a href="mailto:{{ footer.email }}">{{ footer.email }}</a><p>{{ locale=='tr'?'Mesajınıza kart bilgisi, kimlik belgesi veya hesabınızın parolasını eklemeyin.':'Do not include card details, identity documents or your account password in your message.' }}</p></div>
{% else %}<div class="sitemap-grid">{% for group in map %}<nav aria-label="{{ group.title }}"><h2>{{ group.title }}</h2>{% for link in group.links %}<a href="{{ href(link.path) }}">{{ link.label }}</a>{% endfor %}</nav>{% endfor %}</div>{% endif %}</section>{% endblock %}
