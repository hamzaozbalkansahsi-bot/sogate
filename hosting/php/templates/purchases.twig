{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/purchases.twig | Açıklama: Satın alma ve gerçek belge/lot bilgisiyle mal kabulü. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim') }}">Yönetime dön</a><h1>Satın alma ve mal kabulü</h1>{% if principal.role in ['admin','catalog'] %}<form class="card form-stack" data-api="/api/admin/purchases" data-reload="true"><h2>Satın alma aç</h2><input type="hidden" name="action" value="create"><input type="hidden" name="idempotencyKey"><label>Tedarikçi<select name="supplierId" required>{% for supplier in suppliers %}<option value="{{ supplier.id }}">{{ supplier.name }}</option>{% endfor %}</select></label><label>Stok kodu<select name="variantId">{% for variant in variants %}<option value="{{ variant.id }}">{{ variant.sku }} · {{ variant.name }}</option>{% endfor %}</select></label><label>Adet<input type="number" name="quantity" min="1" max="1000000" required></label><label>Birim alış maliyeti<input name="unitCost" inputmode="decimal" placeholder="125,00" required></label><label>Para birimi<select name="currency"><option>TRY</option><option>EUR</option><option>USD</option><option>GBP</option></select></label><label>Satın alma belge referansı<input name="reference" minlength="5" required></label><button class="button">Satın almayı kaydet</button><p class="form-message" role="alert"></p></form>{% endif %}
{% for row in rows %}<article class="card form-stack"><h2>{{ row.supplier }}</h2><p>{{ row.reference }} · {{ row.status|status }}</p>{% for item in row.items %}<p>{{ item.sku }} · {{ item.received }}/{{ item.quantity }} alındı{% if item.unit_cost_minor is defined %} · {{ item.unit_cost_minor|money(row.currency) }}{% endif %}</p>{% endfor %}{% if row.status in ['ordered','partially_received'] and principal.role in ['admin','warehouse'] %}<form class="form-stack" data-api="/api/admin/purchases" data-reload="true"><input type="hidden" name="action" value="receive"><input type="hidden" name="purchaseId" value="{{ row.id }}"><input type="hidden" name="idempotencyKey"><label>Kabul edilecek stok kodu<select name="variantId">{% for item in row.items %}{% if item.received<item.quantity %}<option value="{{ item.variant_id }}">{{ item.sku }} · Kalan {{ item.quantity-item.received }}{% if item.lot_tracking %} · Lot takibi{% endif %}</option>{% endif %}{% endfor %}</select></label><label>Teslim alınan adet<input type="number" name="quantity" min="1" max="1000000" required></label><label>Üretici lotu (izlenen ürünlerde)<input name="lotNumber" maxlength="191"></label><label>Son kullanma tarihi (gerekiyorsa)<input name="expiresAt" type="date"></label><label>Mal kabul belgesi<input name="reference" minlength="5" required></label><label class="php-check"><input type="checkbox" name="quarantine"><span>Doğrudan karantinaya al</span></label><button class="button">Mal kabulünü kaydet</button><p class="form-message" role="alert"></p></form>{% endif %}</article>{% else %}<article class="card"><p>Henüz satın alma kaydı yok.</p></article>{% endfor %}</section>{% endblock %}
