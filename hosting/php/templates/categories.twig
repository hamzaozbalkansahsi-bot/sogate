{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/categories.twig | Açıklama: Gerçek kategori ve ürün görseliyle kategori gezgini. #}
{% extends 'layout.twig' %}{% block content %}<section class="category-browser container"><div class="category-browser-heading"><h1>{{ title }}</h1><a class="category-view-all" href="{{ href('/urunler') }}">{{ t('all') }} <span>{{ productTotal }}</span></a></div><div class="category-tile-grid">{% for category in categoryRows %}<a class="category-tile" href="{{ href('/kategori/'~category.slug) }}"><span class="category-tile-photo">{% if category.image %}<img src="{{ asset(category.image) }}" alt="" width="460" height="460" loading="lazy">{% endif %}</span><span class="category-tile-caption"><strong>{{ locale=='tr'?category.name:category.name_en }}</strong><span>{{ category.product_count }} {{ locale=='tr'?'ürün':'products' }}</span></span></a>{% endfor %}</div></section>{% endblock %}
