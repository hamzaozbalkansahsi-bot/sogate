{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/account.twig | Açıklama: Üyelik, kalıcı oturum, MFA ve sahiplik kontrollü siparişler. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><h1>{{ title }}</h1>{% if account.user %}<nav class="php-admin-nav"><a href="{{ href('/hesap/adresler') }}">{{ locale=='tr'?'Adreslerim':'My addresses' }}</a><a href="{{ href('/favoriler') }}">{{ locale=='tr'?'Favorilerim':'My favourites' }}</a><a href="{{ href('/hesap/tercihler') }}">{{ locale=='tr'?'İletişim ve gizlilik':'Communication and privacy' }}</a></nav><div class="php-checkout-grid"><div class="form-stack"><article class="card form-stack"><h2>{{ account.user.name }}</h2><p>{{ account.user.email }}</p><form data-api="/api/auth/logout" data-next="{{ href('/hesap') }}"><button class="button button-outline">{{ t('sign_out') }}</button><p class="form-message" role="alert"></p></form></article><article class="card"><h2>{{ t('orders') }}</h2>{% for order in orders %}<a class="php-order-link" href="{{ href('/siparis/'~order.id) }}"><span>{{ order.number }}</span><span>{{ order.total_minor|money(order.currency) }}</span></a>{% else %}<p>{{ t('no_orders') }}</p>{% endfor %}</article></div><article class="card form-stack"><h2>{{ t('security') }}</h2>{% if account.user.mfaEnabled %}<p>{{ t('mfa') }}: {{ locale=='tr'?'Açık':'Enabled' }}</p>{% if account.user.role!='customer' %}<a class="button" href="{{ href('/yonetim') }}">{{ t('admin') }}</a>{% endif %}{% else %}<h3>{{ t('mfa') }}</h3><form data-api="/api/auth/mfa/start" id="mfa-start" class="form-stack"><label>{{ t('password') }}<input name="password" type="password" autocomplete="current-password" required></label><button class="button">{{ t('mfa_start') }}</button><p class="form-message" role="alert"></p></form><div id="mfa-setup" class="form-stack" hidden><p>{{ t('mfa_text') }}</p><code id="mfa-secret" class="php-secret"></code><form data-api="/api/auth/mfa/confirm" id="mfa-confirm" class="form-stack"><label>{{ t('code') }}<input name="code" inputmode="numeric" autocomplete="one-time-code" required maxlength="6"></label><button class="button">{{ t('verify') }}</button><p class="form-message" role="alert"></p></form></div><div id="mfa-recovery" hidden><p>{{ t('recovery_codes') }}</p><pre></pre><a class="button" href="{{ adminLogin?href('/yonetim'):href('/hesap') }}">{{ t('continue') }}</a></div>{% endif %}</article></div>{% elseif account.mfaRequired %}<form class="card form-stack narrow" data-api="/api/auth/mfa/login" data-next="{{ adminLogin?href('/yonetim'):href('/hesap') }}"><h2>{{ t('mfa') }}</h2><label>{{ t('code') }}<input name="code" autocomplete="one-time-code" required maxlength="32"></label><button class="button">{{ t('verify') }}</button><p class="form-message" role="alert"></p></form>{% else %}<div class="php-account-grid"><form class="card form-stack" data-api="/api/auth/login" data-next="{{ adminLogin?href('/yonetim'):href('/hesap') }}"><h2>{{ t('sign_in') }}</h2><label>{{ t('email') }}<input type="email" name="email" autocomplete="username" required maxlength="254"></label><label>{{ t('password') }}<input type="password" name="password" autocomplete="current-password" required></label><button class="button">{{ t('sign_in') }}</button><p class="form-message" role="alert"></p></form>{% if not adminLogin %}<form class="card form-stack" data-api="/api/auth/register" data-next="{{ href('/hesap') }}"><h2>{{ t('sign_up') }}</h2><label>{{ t('name') }}<input name="name" autocomplete="name" required minlength="2" maxlength="120"></label><label>{{ t('email') }}<input type="email" name="email" autocomplete="email" required maxlength="254"></label><label>{{ t('password') }}<input type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="128"></label><button class="button">{{ t('sign_up') }}</button><p class="form-message" role="alert"></p></form>{% endif %}</div><details class="card php-reset"><summary>{{ t('forgot') }}</summary><form class="form-stack" data-api="/api/auth/reset/request"><label>{{ t('email') }}<input type="email" name="email" required></label><button class="button button-outline">{{ t('reset') }}</button><p class="form-message" role="status"></p></form></details>{% endif %}</section>{% endblock %}
