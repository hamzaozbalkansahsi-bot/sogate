{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/_catalog-filters.twig | Açıklama: Masaüstü ve mobilde ortak sunucu filtre formu. #}
<form method="get" action="{{ href('/urunler') }}"><input type="hidden" name="q" value="{{ filters.q??'' }}"><input type="hidden" name="sort" value="{{ filters.sort??'recommended' }}"><label>{{ t('categories') }}<select name="category"><option value="">{{ t('all') }}</option>{% for c in catalogCategories %}<option value="{{ c.slug }}" {{ (filters.category??'')==c.slug?'selected':'' }}>{{ locale=='tr'?c.name:c.name_en }}</option>{% endfor %}</select></label><label>{{ locale=='tr'?'En düşük fiyat':'Minimum price' }}<input name="minPrice" value="{{ filters.minPrice??'' }}" inputmode="decimal"></label><label>{{ locale=='tr'?'En yüksek fiyat':'Maximum price' }}<input name="maxPrice" value="{{ filters.maxPrice??'' }}" inputmode="decimal"></label>{% for key,label in {'brand':locale=='tr'?'Marka':'Brand','material':locale=='tr'?'Malzeme':'Material','color':locale=='tr'?'Renk':'Colour','size':locale=='tr'?'Beden':'Size'} %}{% if facets[key]|length %}<label>{{ label }}<select name="{{ key }}"><option value="">{{ t('all') }}</option>{% for row in facets[key] %}<option value="{{ row.value }}" {{ (filters[key]??'')==row.value?'selected':'' }}>{{ row.value }}</option>{% endfor %}</select></label>{% endif %}{% endfor %}<label class="php-check"><input type="checkbox" name="available" value="1" {{ (filters.available??'')=='1'?'checked':'' }}><span>{{ locale=='tr'?'Yalnız stokta olanlar':'In stock only' }}</span></label><button class="button">{{ locale=='tr'?'Filtreleri uygula':'Apply filters' }}</button><a class="text-link" href="{{ href('/urunler') }}">{{ locale=='tr'?'Filtreleri temizle':'Clear filters' }}</a></form>
