{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/blog.twig | Açıklama: Konu/arama, okunabilir yazı ve gerçek ilgili içerik/ürünler. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container blog-page"><p class="eyebrow">SEXOGATE · {{ locale=='tr'?'Rehber ve notlar':'Guides and notes' }}</p><h1>{{ title }}</h1>
{% if article is defined %}<p class="blog-meta">{{ article.readingMinutes }} {{ locale=='tr'?'dakika okuma':'min read' }}</p>{% if article.summary %}<p class="blog-lead">{{ article.summary }}</p>{% endif %}{% if article.cover %}<img class="blog-cover" src="{{ asset(article.cover) }}" alt="" width="1200" height="650">{% endif %}<div class="blog-reading-layout"><nav class="blog-toc" aria-label="{{ locale=='tr'?'İçindekiler':'On this page' }}"><h2>{{ locale=='tr'?'İçindekiler':'On this page' }}</h2>{% for part in article.sections %}{% if part.title %}<a href="#{{ part.id }}">{{ part.title }}</a>{% endif %}{% endfor %}<a href="{{ href('/blog') }}">{{ locale=='tr'?'Tüm yazılar':'All articles' }}</a></nav><article class="information-prose">{% for part in article.sections %}<section id="{{ part.id }}">{% if part.title %}<h2>{{ part.title }}</h2>{% endif %}{% for paragraph in part.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</section>{% endfor %}<div class="product-share"><button type="button" class="button button-outline" data-share-product>{{ locale=='tr'?'Yazıyı paylaş':'Share article' }}</button><p class="form-message" role="status"></p></div></article></div>{% if article.products|length %}<h2>{{ locale=='tr'?'Yazıda geçen ürünler':'Products in this article' }}</h2>{% include '_cards.twig' with {products:article.products} %}{% endif %}{% if article.related|length %}<h2>{{ locale=='tr'?'Okumaya devam edin':'Keep reading' }}</h2><div class="blog-grid">{% for entry in article.related %}<article class="blog-card"><h3><a href="{{ href('/blog/'~entry.slug) }}">{{ entry.title }}</a></h3><p>{{ entry.summary }}</p></article>{% endfor %}</div>{% endif %}
{% else %}<form class="blog-search" method="get"><label>{{ locale=='tr'?'Yazılarda ara':'Search articles' }}<input type="search" name="q" value="{{ blog.q }}" maxlength="100"></label><label>{{ locale=='tr'?'Konu':'Topic' }}<select name="topic"><option value="">{{ t('all') }}</option>{% for row in blog.topics %}<option value="{{ row.topic }}" {{ row.topic==blog.topic?'selected':'' }}>{{ row.topic }}</option>{% endfor %}</select></label><button class="button">{{ t('search') }}</button></form><div class="blog-grid">{% for entry in blog.rows %}<article class="blog-card">{% if entry.cover %}<a href="{{ href('/blog/'~entry.slug) }}" aria-label="{{ entry.title }}"><img src="{{ asset(entry.cover) }}" alt="" width="640" height="420" loading="lazy"></a>{% endif %}<h2><a href="{{ href('/blog/'~entry.slug) }}">{{ entry.title }}</a></h2><p>{{ entry.summary }}</p><a class="text-link" href="{{ href('/blog/'~entry.slug) }}">{{ locale=='tr'?'Yazıyı oku':'Read article' }}</a></article>{% else %}<article class="card"><h2>{{ locale=='tr'?'Rehberler burada yer alacak':'Guides will appear here' }}</h2><p>{{ locale=='tr'?'Yayımlanan yazılara bu sayfadan ulaşabilirsiniz.':'Published articles will be available on this page.' }}</p></article>{% endfor %}</div><nav class="php-pagination" aria-label="{{ locale=='tr'?'Blog sayfaları':'Blog pages' }}">{% if blog.page>1 %}<a class="button button-outline" href="?{{ {q:blog.q,topic:blog.topic,page:blog.page-1}|url_encode }}">{{ t('previous') }}</a>{% endif %}{% if blog.total>blog.page*12 %}<a class="button button-outline" href="?{{ {q:blog.q,topic:blog.topic,page:blog.page+1}|url_encode }}">{{ t('next') }}</a>{% endif %}</nav>{% endif %}</section>{% endblock %}
