{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/order.twig | Açıklama: Yetkili sipariş snapshot'ını ve ayrı ödeme durumunu gösterir. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container narrow"><div class="card form-stack"><p class="eyebrow">{{ order.number }}</p><h1>{{ t('order_received') }}</h1><p>{{ t('private_order') }}</p><dl><dt>{{ t('status') }}</dt><dd>{{ order.status|status }}</dd><dt>{{ t('payment') }}</dt><dd>{{ order.payment_status|status }}</dd></dl>{% for item in order.items %}<div class="php-summary-row"><span>{{ item.name }} × {{ item.quantity }}</span><strong>{{ item.unit_minor|money(order.currency) }}</strong></div>{% endfor %}<div class="php-summary-row php-total"><strong>{{ t('total') }}</strong><strong>{{ order.total_minor|money(order.currency) }}</strong></div><a class="button button-outline" href="{{ href('/urunler') }}">{{ t('continue') }}</a></div>{% if order.payment_status in ['succeeded','partially_refunded'] %}<form class="card form-stack" data-api="/api/returns" data-reload="true"><h2>{{ locale=='tr'?'İade talebi':'Return request' }}</h2><input type="hidden" name="orderId" value="{{ order.id }}"><input type="hidden" name="trackingToken" value="{{ trackingToken }}"><input type="hidden" name="idempotencyKey"><label>{{ t('products') }}<select name="variantId">{% for item in order.items %}<option value="{{ item.variant_id }}">{{ item.name }}</option>{% endfor %}</select></label><label>{{ t('quantity') }}<input name="quantity" type="number" min="1" max="99" required></label><label>{{ locale=='tr'?'Başvuru gerekçesi':'Reason' }}<textarea name="reason" minlength="5" maxlength="2000" required></textarea></label><label>{{ locale=='tr'?'Ambalaj / hijyen mührü':'Packaging / hygiene seal' }}<select name="sealStatus"><option value="unknown">{{ locale=='tr'?'Belirtilmedi':'Not specified' }}</option><option value="unopened">{{ locale=='tr'?'Açılmadı':'Unopened' }}</option><option value="opened">{{ locale=='tr'?'Açıldı':'Opened' }}</option></select></label><button class="button">{{ locale=='tr'?'Talebi gönder':'Send request' }}</button><p class="form-message" role="alert"></p></form>{% endif %}{% for row in returns %}<article class="card"><h2>{{ locale=='tr'?'İade talebi':'Return request' }}</h2><p>{{ row.quantity }} · {{ row.status|status }}</p></article>{% endfor %}{% for shipment in shipments %}<article class="card"><h2>{{ shipment.carrier }}</h2><p>{{ shipment.tracking_number }}</p><p>{{ shipment.status|status }}</p></article>{% endfor %}</section>{% endblock %}
