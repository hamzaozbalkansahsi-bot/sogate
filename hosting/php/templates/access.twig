{% extends 'layout.twig' %}{% block content %}<section class="section container narrow"><form class="card form-stack" method="post" action="{{ basePath }}/_access"><input type="hidden" name="_csrf" value="{{ csrf }}"><p class="eyebrow">SEXOGATE</p><h1>{{ t('stage_title') }}</h1><p>{{ t('stage_text') }}</p><label>{{ t('access_user') }}<input name="username" required autocomplete="username"></label><label>{{ t('access_password') }}<input name="password" type="password" required autocomplete="current-password"></label><button class="button">{{ t('sign_in') }}</button></form></section>{% endblock %}
