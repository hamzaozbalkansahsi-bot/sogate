{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/navigation.twig | Açıklama: NODENO akışına uyumlu kategori, arama ve mobil gezinme. #}
<header class="site-header"><div class="container header-main"><a class="brand" href="{{ href('/') }}" aria-label="SEXOGATE"><img src="{{ asset('/brand/app/logo-stacked.svg') }}" width="458" height="269" alt="SEXOGATE"></a><form class="header-search" action="{{ href('/urunler') }}" method="get" role="search"><label class="sr-only" for="header-query">{{ t('search') }}</label><input type="search" id="header-query" name="q" placeholder="{{ locale=='tr'?'Ürün, kategori veya stok kodu ara':'Search products, categories or SKU' }}" maxlength="100" autocomplete="off"><button type="submit" aria-label="{{ t('search') }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg></button></form><div class="header-actions"><a href="{{ href('/hesap') }}">{{ t('account') }}</a><a href="{{ href('/sepet') }}">{{ t('cart') }} <span data-cart-count data-empty="{{ cartCount==0?'true':'false' }}">{{ cartCount }}</span></a><a href="{{ basePath }}{{ locale=='tr'?'/en/':'/' }}" lang="{{ locale=='tr'?'en':'tr' }}">{{ locale=='tr'?'EN':'TR' }}</a></div></div><nav class="category-nav" aria-label="{{ t('categories') }}"><div class="container"><a href="{{ href('/kategoriler') }}">{{ t('categories') }}</a><a href="{{ href('/urunler') }}">{{ t('all') }}</a>{% for category in categories %}<a href="{{ href('/kategori/'~category.slug) }}">{{ locale=='en'?category.name_en:category.name }}</a>{% endfor %}<a href="{{ href('/blog') }}">Blog</a><a href="{{ href('/rehber') }}">{{ t('guide') }}</a></div></nav></header>
<nav class="mobile-bottom-nav" aria-label="{{ locale=='tr'?'Mobil gezinme':'Mobile navigation' }}">
 <a href="{{ href('/') }}"{% if pageType=='home' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8M5 9v12h5v-7h4v7h5V9"/></svg>{{ locale=='tr'?'Ana sayfa':'Home' }}</a>
 <a href="{{ href('/kategoriler') }}"{% if pageType|default('store')=='categories' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>{{ t('categories') }}</a>
 <a href="{{ href('/favoriler') }}"{% if pageType=='favorites' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21 3 12C-3 5 7-1 12 6c5-7 15-1 9 6Z"/></svg>{{ locale=='tr'?'Favorilerim':'Favourites' }}</a>
 <a href="{{ href('/sepet') }}"{% if pageType=='cart' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h2l3 12h11l3-9H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>{{ t('cart') }} <span data-cart-count data-empty="{{ cartCount==0?'true':'false' }}">{{ cartCount }}</span></a>
 <a href="{{ href('/hesap') }}"{% if pageType in ['account','customer'] %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3"/></svg>{{ locale=='tr'?'Hesabım':'Account' }}</a>
</nav>
<dialog id="quick-product" class="discovery-dialog quick-product" aria-labelledby="quick-title"><div class="drawer-heading"><h2 id="quick-title">{{ locale=='tr'?'Hızlı inceleme':'Quick view' }}</h2><button type="button" data-dialog-close aria-label="{{ t('close') }}">×</button></div><div id="quick-content" role="status"></div></dialog>
<dialog id="image-zoom" class="discovery-dialog image-zoom" aria-label="{{ locale=='tr'?'Ürün görseli':'Product image' }}"><button type="button" data-dialog-close aria-label="{{ t('close') }}">×</button><img alt="" width="900" height="1000"></dialog>
