{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/navigation.twig | Açıklama: NODENO akışına uyumlu kategori, arama ve mobil gezinme. #}
<header class="site-header"><div class="container header-main"><a class="brand" href="{{ href('/') }}" aria-label="SEXOGATE"><img src="{{ asset('/brand/app/logo-stacked.svg') }}" width="458" height="269" alt="SEXOGATE"></a><div class="header-search-wrap"><form class="header-search" action="{{ href('/urunler') }}" method="get" role="search"><label class="sr-only" for="header-query">{{ t('search') }}</label><input type="search" id="header-query" name="q" placeholder="{{ locale=='tr'?'Ürün, kategori veya stok kodu ara':'Search products, categories or SKU' }}" maxlength="100" autocomplete="off" role="combobox" aria-controls="search-suggestions" aria-autocomplete="list" aria-expanded="false"><button type="submit" aria-label="{{ t('search') }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg></button></form><div id="search-suggestions" class="search-suggestions" role="listbox" aria-label="{{ locale=='tr'?'Arama önerileri':'Search suggestions' }}" hidden></div></div><div class="header-actions"><details class="account-menu"><summary aria-label="{{ t('account') }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3"/></svg><span>{{ t('account') }}</span></summary><nav aria-label="{{ locale=='tr'?'Hesap işlemleri':'Account menu' }}"><a href="{{ href('/hesap') }}">{{ principal?(locale=='tr'?'Hesabım ve siparişlerim':'My account and orders'):t('sign_in') }}</a><a href="{{ href('/favoriler') }}">{{ locale=='tr'?'Favorilerim':'Favourites' }} <span data-shopping-count="favorites">0</span></a><a href="{{ href('/listeler') }}">{{ locale=='tr'?'Özel listelerim':'My private lists' }}</a><a href="{{ href('/karsilastir') }}">{{ locale=='tr'?'Ürün karşılaştırma':'Compare products' }}</a>{% if principal %}<a href="{{ href('/hesap/adresler') }}">{{ locale=='tr'?'Adreslerim':'My addresses' }}</a><a href="{{ href('/hesap/tercihler') }}">{{ locale=='tr'?'İletişim tercihlerim':'Communication preferences' }}</a>{% endif %}</nav></details><a class="header-cart-link" href="{{ href('/sepet') }}">{{ t('cart') }} <span data-cart-count data-empty="{{ cartCount==0?'true':'false' }}">{{ cartCount }}</span></a><label class="header-select"><span class="sr-only">{{ locale=='tr'?'Dil':'Language' }}</span><select data-language-select><option value="tr" {{ locale=='tr'?'selected':'' }}>TR</option><option value="en" {{ locale=='en'?'selected':'' }}>EN</option></select></label><label class="header-select"><span class="sr-only">{{ locale=='tr'?'Gösterim para birimi':'Display currency' }}</span><select data-currency-select>{% for currency in storePreferences.currencies %}<option value="{{ currency }}" {{ storePreferences.currency==currency?'selected':'' }}>{{ currency }}</option>{% endfor %}{% if storePreferences.currency not in storePreferences.currencies %}<option selected disabled value="{{ storePreferences.currency }}">{{ storePreferences.currency }} · —</option>{% endif %}</select></label><label class="header-select header-country"><span class="sr-only">{{ locale=='tr'?'Teslimat ülkesi':'Delivery country' }}</span><select data-country-select>{% for country in storePreferences.countries %}<option value="{{ country.code }}" {{ storePreferences.country==country.code?'selected':'' }}>{{ country.name }}</option>{% else %}<option value="">{{ locale=='tr'?'Teslimat ülkesi':'Delivery country' }}</option>{% endfor %}</select></label></div></div><nav class="category-nav" aria-label="{{ t('categories') }}"><div class="container"><div class="category-entry"><a href="{{ href('/kategoriler') }}">{{ t('categories') }}</a><button type="button" data-mega-toggle aria-controls="mega-menu" aria-expanded="false" aria-label="{{ locale=='tr'?'Kategori menüsünü aç':'Open category menu' }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button></div><a href="{{ href('/urunler') }}">{{ t('all') }}</a>{% for category in categoryRoots|slice(0,7) %}<a href="{{ href('/kategori/'~category.slug) }}">{{ locale=='en'?category.name_en:category.name }}</a>{% endfor %}<a href="{{ href('/koleksiyonlar') }}">{{ t('collections') }}</a><a href="{{ href('/blog') }}">Blog</a><a href="{{ href('/rehber') }}">{{ t('guide') }}</a></div></nav><div class="mega-menu container" id="mega-menu" hidden><div class="mega-roots" aria-label="{{ locale=='tr'?'Ana kategoriler':'Main categories' }}">{% for root in categoryRoots %}<button type="button" data-mega-root="{{ root.slug }}" aria-pressed="{{ loop.first?'true':'false' }}">{{ locale=='tr'?root.name:root.name_en }} <span>{{ root.product_count }}</span></button>{% endfor %}<a class="text-link" href="{{ href('/kategoriler') }}">{{ locale=='tr'?'Tüm kategoriler':'All categories' }}</a></div><div class="mega-content">{% for root in categoryRoots %}<section data-mega-panel="{{ root.slug }}" {% if not loop.first %}hidden{% endif %}><h2><a href="{{ href('/kategori/'~root.slug) }}">{{ locale=='tr'?root.name:root.name_en }}</a></h2><div class="mega-columns">{% for child in navigationCategories %}{% if child.parent_slug==root.slug %}<section><h3><a href="{{ href('/kategori/'~child.slug) }}">{{ locale=='tr'?child.name:child.name_en }}</a></h3>{% for leaf in navigationCategories %}{% if leaf.parent_slug==child.slug %}<a href="{{ href('/kategori/'~leaf.slug) }}">{{ locale=='tr'?leaf.name:leaf.name_en }}</a>{% endif %}{% endfor %}<a class="text-link" href="{{ href('/kategori/'~child.slug) }}">{{ locale=='tr'?'Tümünü incele':'View all' }} · {{ child.product_count }}</a></section>{% endif %}{% endfor %}</div><a class="text-link" href="{{ href('/kategori/'~root.slug) }}">{{ locale=='tr'?'Tüm ürünler':'All products' }} · {{ root.product_count }}</a></section>{% endfor %}</div></div></header>
<nav class="mobile-bottom-nav" aria-label="{{ locale=='tr'?'Mobil gezinme':'Mobile navigation' }}">
 <a href="{{ href('/') }}"{% if pageType=='home' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8M5 9v12h5v-7h4v7h5V9"/></svg>{{ locale=='tr'?'Ana sayfa':'Home' }}</a>
 <a href="{{ href('/kategoriler') }}"{% if pageType|default('store')=='categories' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>{{ t('categories') }}</a>
 <a href="{{ href('/favoriler') }}"{% if pageType=='favorites' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21 3 12C-3 5 7-1 12 6c5-7 15-1 9 6Z"/></svg>{{ locale=='tr'?'Favorilerim':'Favourites' }}</a>
 <a href="{{ href('/sepet') }}"{% if pageType=='cart' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h2l3 12h11l3-9H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>{{ t('cart') }} <span data-cart-count data-empty="{{ cartCount==0?'true':'false' }}">{{ cartCount }}</span></a>
 <a href="{{ href('/hesap') }}"{% if pageType in ['account','customer'] %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3"/></svg>{{ locale=='tr'?'Hesabım':'Account' }}</a>
</nav>
<dialog id="quick-product" class="discovery-dialog quick-product" aria-labelledby="quick-title"><div class="drawer-heading"><h2 id="quick-title">{{ locale=='tr'?'Hızlı inceleme':'Quick view' }}</h2><button type="button" data-dialog-close aria-label="{{ t('close') }}">×</button></div><div id="quick-content" role="status"></div></dialog>
<dialog id="image-zoom" class="discovery-dialog image-zoom" aria-label="{{ locale=='tr'?'Ürün görseli':'Product image' }}"><button type="button" data-dialog-close aria-label="{{ t('close') }}">×</button><img alt="" width="900" height="1000"></dialog>
