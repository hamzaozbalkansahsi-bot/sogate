{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/returns-admin.twig | Açıklama: İade değerlendirme, teslim alma, kalite ve finans adımları. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim/siparisler') }}">Siparişler</a><h1>İade işlemleri</h1>{% for row in rows %}<article class="card form-stack"><p class="eyebrow">{{ row.number }}</p><h2>{{ row.name }} · {{ row.quantity }} adet</h2><p>{{ row.status|status }}</p>
{% if row.status=='requested' and principal.role in ['admin','support'] %}<form class="form-stack" data-api="/api/admin/returns" data-reload="true"><input type="hidden" name="id" value="{{ row.id }}"><input type="hidden" name="action" value="decide"><input type="hidden" name="idempotencyKey"><label>Karar gerekçesi<textarea name="reason" minlength="5" maxlength="2000" required></textarea></label><label class="php-check"><input type="checkbox" name="approved"><span>İnceleme için iadeyi kabul et</span></label><button class="button">Kararı kaydet</button><p class="form-message" role="alert"></p></form>{% endif %}
{% if row.fulfillment_source=='warehouse' and row.status=='approved' and principal.role in ['admin','warehouse'] %}<form class="form-stack" data-api="/api/admin/returns" data-reload="true"><input type="hidden" name="id" value="{{ row.id }}"><input type="hidden" name="action" value="receive"><input type="hidden" name="idempotencyKey"><label>Depo teslim alma referansı<input name="reference" minlength="5" maxlength="500" required></label><button class="button">Karantinaya teslim al</button><p class="form-message" role="alert"></p></form>{% endif %}
{% if row.fulfillment_source=='warehouse' and row.status=='received' and principal.role in ['admin','warehouse'] %}<form class="form-stack" data-api="/api/admin/returns" data-reload="true"><input type="hidden" name="id" value="{{ row.id }}"><input type="hidden" name="action" value="inspect"><input type="hidden" name="idempotencyKey"><label>Kalite kararı<select name="disposition"><option value="quarantine">Karantinada tut</option><option value="restock">Satılabilir stoğa kabul et</option><option value="dispose">İmha / stoktan ayır</option></select></label><label>İnceleme gerekçesi<textarea name="reason" minlength="5" maxlength="2000" required></textarea></label><button class="button">Kalite kararını kaydet</button><p class="form-message" role="alert"></p></form>{% endif %}
{% if row.fulfillment_source=='supplier' and row.status in ['approved','received'] and principal.role=='admin' %}<form class="form-stack" data-api="/api/admin/suppliers" data-reload="true"><input type="hidden" name="id" value="{{ row.id }}"><input type="hidden" name="action" value="{{ row.status=='approved'?'return-receive':'return-inspect' }}"><input type="hidden" name="idempotencyKey"><p>Bu ürün tedarikçiye döner. Kendi depo stoğu artmaz.</p><label>{{ row.status=='approved'?'Tedarikçi teslim alma belge referansı':'Tedarikçi kalite inceleme belge referansı' }}<textarea name="reference" minlength="5" maxlength="1000" required></textarea></label><button class="button">Dış sistem kanıtını kaydet</button><p class="form-message" role="alert"></p></form>{% endif %}
{% if row.status=='inspected' and principal.role in ['admin','finance'] %}<form class="form-stack" data-api="/api/admin/returns" data-reload="true"><input type="hidden" name="id" value="{{ row.id }}"><input type="hidden" name="action" value="refund"><input type="hidden" name="idempotencyKey"><p>Ürün bedeli, siparişteki indirim ve vergi dağılımından hesaplanır. Teslimat bedeli bu ürün iadesine otomatik eklenmez.</p><button class="button">Ürün bedeli iadesini başlat</button><p class="form-message" role="alert"></p></form>{% endif %}</article>{% else %}<div class="card"><p>Henüz iade talebi yok.</p></div>{% endfor %}</section>{% endblock %}
