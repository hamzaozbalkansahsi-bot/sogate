{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/layout.twig | Açıklama: Korunan marka ve erişilebilir PHP sayfa çerçevesi. #}
<!doctype html><html lang="{{ locale }}" dir="ltr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="rating" content="adult">{% if seo is defined %}<meta name="description" content="{{ seo.description }}"><link rel="canonical" href="{{ seo.canonical }}"><meta property="og:title" content="{{ seo.title }}"><meta property="og:description" content="{{ seo.description }}"><meta property="og:url" content="{{ seo.canonical }}">{% for language,url in seo.alternates %}<link rel="alternate" hreflang="{{ language }}" href="{{ url }}">{% endfor %}<script type="application/ld+json">{{ json_ld(seo.schema) }}</script>{% endif %}<meta name="robots" content="noindex,nofollow"><meta name="csrf-token" content="{{ csrf }}"><title>{{ seo is defined?seo.title:title }} · SEXOGATE</title><link rel="icon" type="image/svg+xml" href="{{ asset('/brand/favicon.svg') }}"><link rel="stylesheet" href="{{ asset('/fonts.css') }}"><link rel="stylesheet" href="{{ asset('/site.css') }}"><link rel="stylesheet" href="{{ asset('/hosting.css') }}"><script defer src="{{ asset('/app.js') }}"></script></head>
<body data-base="{{ basePath }}" data-locale="{{ locale }}"><a class="skip-link" href="#main">{{ locale=='tr'?'İçeriğe geç':'Skip to content' }}</a>
<header class="site-header"><div class="container header-main"><a class="brand" href="{{ href('/') }}" aria-label="SEXOGATE"><img src="{{ asset('/brand/logo-horizontal.svg') }}" width="245" height="70" alt="SEXOGATE"></a><nav class="desktop-nav" aria-label="{{ locale=='tr'?'Ana menü':'Main navigation' }}"><a href="{{ href('/urunler') }}">{{ t('products') }}</a><a href="{{ href('/koleksiyonlar') }}">{{ t('collections') }}</a><a href="{{ href('/rehber') }}">{{ t('guide') }}</a></nav><div class="header-actions"><a href="{{ href('/hesap') }}">{{ t('account') }}</a><a href="{{ href('/sepet') }}">{{ t('cart') }}</a><a href="{{ basePath }}{{ locale=='tr'?'/en/':'/' }}" lang="{{ locale=='tr'?'en':'tr' }}">{{ locale=='tr'?'EN':'TR' }}</a></div></div><nav class="category-nav" aria-label="{{ t('categories') }}"><div class="container"><a href="{{ href('/urunler') }}">{{ t('all') }}</a>{% for category in categories %}<a href="{{ href('/kategori/'~category.slug) }}">{{ locale=='en'?category.name_en:category.name }}</a>{% endfor %}</div></nav></header>
<main id="main" tabindex="-1">{% block content %}{% endblock %}</main>
<footer class="php-footer"><div class="container php-footer-grid"><div><img src="{{ asset('/brand/logo-horizontal-light.svg') }}" width="245" height="70" alt="SEXOGATE"><p>{{ t('adult_footer') }}</p></div><nav aria-label="{{ t('help') }}"><a href="{{ href('/rehber') }}">{{ t('guide') }}</a><a href="{{ href('/sss') }}">{{ t('faq') }}</a><a href="{{ href('/iletisim') }}">{{ t('contact') }}</a></nav><nav aria-label="{{ t('privacy') }}"><a href="{{ href('/yasal/privacy') }}">{{ t('privacy') }}</a><a href="{{ href('/yasal/terms') }}">{{ t('terms') }}</a>{% if principal and principal.role!='customer' %}<a href="{{ href('/yonetim') }}">{{ t('admin') }}</a>{% endif %}</nav></div><div class="container small">© {{ 'now'|date('Y') }} SEXOGATE. {{ t('copyright') }}<div class="php-credits">Geliştirici: PTYS Technoligess LLC · Tasarım: Hamza ÖZBALKAN</div></div></footer>
<dialog id="age-notice" class="php-dialog" aria-labelledby="age-title" aria-describedby="age-description"><img src="{{ asset('/brand/symbol.svg') }}" alt="" width="66" height="84"><h2 id="age-title">{{ t('age_title') }}</h2><p id="age-description">{{ t('age_text') }}</p><button class="button full" id="age-accept" type="button">{{ t('age_confirm') }}</button><button class="text-link" id="age-exit" type="button">{{ t('exit') }}</button></dialog><p class="sr-only" id="site-status" role="status" aria-live="polite"></p>
</body></html>
