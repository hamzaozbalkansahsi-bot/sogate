{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/layout.twig | Açıklama: Korunan marka ve erişilebilir PHP sayfa çerçevesi. #}
<!doctype html><html lang="{{ locale }}" dir="ltr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="rating" content="adult">{% if seo is defined %}<meta name="description" content="{{ seo.description }}"><link rel="canonical" href="{{ seo.canonical }}"><meta property="og:title" content="{{ seo.title }}"><meta property="og:description" content="{{ seo.description }}"><meta property="og:url" content="{{ seo.canonical }}">{% for language,url in seo.alternates %}<link rel="alternate" hreflang="{{ language }}" href="{{ url }}">{% endfor %}<script type="application/ld+json">{{ json_ld(seo.schema) }}</script>{% endif %}<meta name="robots" content="noindex,nofollow"><meta name="csrf-token" content="{{ csrf }}"><title>{{ seo is defined?seo.title:title }} · SEXOGATE</title><link rel="icon" type="image/png" sizes="32x32" href="{{ asset('/brand/app/favicon-32.png') }}"><link rel="icon" type="image/x-icon" href="{{ asset('/brand/app/favicon.ico') }}"><link rel="apple-touch-icon" sizes="180x180" href="{{ asset('/brand/app/apple-touch-icon.png') }}"><link rel="manifest" href="{{ basePath }}/manifest.webmanifest"><meta name="theme-color" content="#5A0A20"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="SEXOGATE"><meta name="apple-mobile-web-app-status-bar-style" content="default"><link rel="stylesheet" href="{{ asset('/fonts.css') }}"><link rel="stylesheet" href="{{ asset('/site.css') }}"><link rel="stylesheet" href="{{ asset('/hosting.css') }}"><link rel="stylesheet" href="{{ asset('/experience.css') }}"><link rel="stylesheet" href="{{ asset('/navigation.css') }}"><link rel="preload" as="font" type="font/woff2" href="{{ asset('/fonts/montserrat-variable.woff2') }}" crossorigin><link rel="preload" as="font" type="font/woff2" href="{{ asset('/fonts/playfairdisplay-variable.woff2') }}" crossorigin><link rel="stylesheet" href="{{ asset('/discovery.css') }}"><link rel="stylesheet" href="{{ asset('/category-brand.css') }}"><script defer src="{{ asset('/app.js') }}"></script><script defer src="{{ asset('/discovery.js') }}"></script><script defer src="{{ asset('/shopping.js') }}"></script><script defer src="{{ asset('/public-navigation.js') }}"></script><script defer src="{{ asset('/checkout-experience.js') }}"></script><script defer src="{{ asset('/personal-shopping.js') }}"></script><link rel="stylesheet" href="{{ asset('/parity.css') }}"><script defer src="{{ asset('/storefront-navigation.js') }}"></script><script defer src="{{ asset('/product-gallery.js') }}"></script><script defer src="{{ asset('/media-admin.js') }}"></script></head>
<body data-base="{{ basePath }}" data-locale="{{ locale }}" data-page="{{ pageType|default('store') }}"><a class="skip-link" href="#main">{{ locale=='tr'?'İçeriğe geç':'Skip to content' }}</a>
<div class="site-shell">{% include 'navigation.twig' %}
<main id="main" tabindex="-1">{% block content %}{% endblock %}</main>
{% include 'footer.twig' %}</div>{% include '_personal-dialogs.twig' %}
<dialog id="age-notice" class="php-dialog php-age-dialog" aria-labelledby="age-title" aria-describedby="age-description">
 <div class="age-shell">
  <div class="age-art" aria-hidden="true"><img class="age-portrait" src="{{ asset('/brand/app/liora-640.webp') }}" srcset="{{ asset('/brand/app/liora-640.webp') }} 640w, {{ asset('/brand/app/liora-1200.webp') }} 1200w" sizes="(max-width: 640px) 100vw, 440px" alt="" width="640" height="640"><img class="age-art-brand" src="{{ asset('/brand/app/logo-stacked-light.svg') }}" alt="" width="458" height="269"></div>
  <div class="age-content"><div class="age-topline"><span>{{ locale=='tr'?'Yalnızca yetişkinler için':'For adults only' }}</span><span class="age-number" aria-hidden="true">18+</span></div>
   <h2 id="age-title">{{ locale=='tr'?'Tutkunu':'Discover' }} <em>{{ locale=='tr'?'Keşfet.':'your passion.' }}</em></h2>
   <p id="age-description">{{ locale=='tr'?'Size özel bu alanda yetişkinlere yönelik koleksiyonlar bulunur. Devam etmek için 18 yaş ve üzerinde olduğunuzu onaylayın.':'This space features collections for adults. Please confirm that you are 18 or older to continue.' }}</p>
   <button class="button age-confirm" id="age-accept" type="button">{{ locale=='tr'?'18 yaş ve üzerindeyim':'I am 18 or older' }}<span aria-hidden="true">↗</span></button>
   <button class="age-decline" id="age-exit" type="button">{{ locale=='tr'?'18 yaşından küçüğüm · Çıkış':'I am under 18 · Leave' }}</button>
   <p class="age-note">{{ locale=='tr'?'Tercihiniz bu cihazda hatırlanır.':'Your choice is remembered on this device.' }}</p>
  </div>
 </div>
</dialog><p class="sr-only" id="site-status" role="status" aria-live="polite"></p>
</body></html>
