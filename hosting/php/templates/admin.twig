{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/admin.twig | Açıklama: Açık yönetim yüzeyi ve çalışan katalog/depo işlemleri. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><p class="eyebrow">SEXOGATE</p><h1>Yönetim</h1><nav class="php-admin-nav">{% if principal.role in ['admin','catalog','finance'] %}<a href="{{ href('/yonetim/fiyatlar') }}">Fiyat listeleri</a>{% endif %}{% if principal.role=='admin' %}<a href="{{ href('/yonetim/pazarlar') }}">Ülkeler ve vergi</a><a href="{{ href('/yonetim/uygunluk') }}">Ürün uygunluğu</a>{% endif %}</nav><nav class="php-admin-nav">{% if principal.role in ['admin','finance'] %}<a href="{{ href('/yonetim/raporlar') }}">Raporlar</a>{% endif %}{% if principal.role=='admin' %}<a href="{{ href('/yonetim/roller') }}">Kullanıcı ve roller</a><a href="{{ href('/yonetim/is-kuyrugu') }}">İş kuyruğu</a><a href="{{ href('/yonetim/islem-kaydi') }}">İşlem geçmişi</a>{% endif %}</nav><nav class="php-admin-nav"><a href="{{ href('/yonetim/satin-alma') }}">Satın alma</a><a href="{{ href('/yonetim/lotlar') }}">Lot ve geri çağırma</a></nav><nav class="php-admin-nav"><a href="{{ href('/yonetim/icerik') }}">İçerik</a><a href="{{ href('/yonetim/seo') }}">SEO kontrolü</a>{% if principal.role=='admin' %}<a href="{{ href('/yonetim/tedarikciler') }}">Tedarikçiler ve gönderim</a><a href="{{ href('/yonetim/hukuk') }}">Hukuk metinleri</a>{% endif %}</nav><nav class="php-admin-nav" aria-label="Yönetim"><a href="{{ href('/yonetim/katalog') }}">Ürünler</a><a href="{{ href('/yonetim/ice-aktarim') }}">İçe aktarma</a><a href="{{ href('/yonetim/stok') }}">Depo ve stok</a><a href="{{ href('/yonetim/siparisler') }}">Siparişler</a><a href="{{ href('/yonetim/iadeler') }}">İadeler</a>{% if principal.role=='admin' %}<a href="{{ href('/yonetim/ayarlar') }}">İşletme bilgileri</a><a href="{{ href('/yonetim/entegrasyonlar') }}">Bağlantılar</a>{% endif %}</nav>
{% if section in ['katalog','stok'] %}<div class="card php-table-wrap"><table><thead><tr><th>Ürün</th><th>Stok kodu</th><th>Durum</th><th>Depoda</th><th>Güvenlik payı</th>{% if section=='katalog' %}<th>Satış fiyatı</th>{% endif %}</tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.name }}</td><td>{{ row.sku }}</td><td>{{ row.status|status }}</td><td>{{ row.on_hand??0 }}</td><td>{{ row.safety_stock??0 }}</td>{% if section=='katalog' %}<td>{{ row.price_minor|money }}</td>{% endif %}</tr>{% else %}<tr><td colspan="6">Henüz ürün kaydı yok.</td></tr>{% endfor %}</tbody></table></div>{% endif %}
{% if section=='katalog' and principal.role in ['admin','catalog'] %}<div class="php-account-grid"><form class="card form-stack" data-api="/api/admin/catalog" data-reload="true"><h2>Ürün ve seçenek ekle</h2><label>Ürün adı<input name="name" required maxlength="300"></label><label>İngilizce ürün adı<input name="nameEn" required maxlength="300"></label><label>Ürün bağlantısı<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="120"></label><label>Stok kodu<input name="sku" required maxlength="191"></label><label>Kategori<select name="category">{% for category in categories %}<option value="{{ category.slug }}">{{ category.name }}</option>{% endfor %}</select></label><label>Seçenek adı<input name="variantName" required placeholder="Bordo · Tek beden"></label><label>Satış fiyatı (TL)<input name="price" inputmode="decimal" placeholder="149,50" required></label><label>Alış maliyeti (TL)<input name="cost" inputmode="decimal" value="0,00" required></label><label>Görsel<select name="image">{% for n in ['01','02','03','04','05','06'] %}<option value="/media/atelier-{{ n }}.svg">Katalog görseli {{ n }}</option>{% endfor %}</select></label><label>Açıklama<textarea name="description" rows="3"></textarea></label><label>İngilizce açıklama<textarea name="descriptionEn" rows="3"></textarea></label><label class="php-check"><input type="checkbox" name="fixture" checked><span>İzole test ürünü</span></label><button class="button">Taslak oluştur</button><p class="form-message" role="alert"></p></form>{% if principal.role=='admin' %}<form class="card form-stack" data-api="/api/admin/catalog" data-reload="true"><h2>Ülke uygunluğu ve yayın</h2><input type="hidden" name="action" value="publish"><label>Ürün<select name="id">{% for row in rows %}<option value="{{ row.id }}">{{ row.name }}</option>{% endfor %}</select></label><label>Ülke<input name="country" value="TR" required pattern="[A-Z]{2}"></label><p class="small muted">Yalnız belge ve ülke koşullarını incelediğiniz ürünü yayımlayın. Onay, işletme sorumluluğundadır.</p><button class="button">Onayla ve yayımla</button><p class="form-message" role="alert"></p></form>{% endif %}</div>{% endif %}
{% if section=='stok' %}<form class="card form-stack narrow" data-api="/api/admin/inventory" data-reload="true"><h2>Mal kabulü</h2><label>Stok kodu<select name="variantId" required>{% for row in rows %}<option value="{{ row.variant_id }}">{{ row.sku }} · {{ row.name }}</option>{% endfor %}</select></label><label>Alınan adet<input name="quantity" type="number" min="1" max="1000000" required></label><label>Belge referansı ve gerekçe<textarea name="reason" required minlength="5"></textarea></label><input name="idempotencyKey" type="hidden"><button class="button">Mal kabulünü kaydet</button><p class="form-message" role="alert"></p></form>{% endif %}
{% if section=='siparisler' %}<div class="card php-table-wrap"><table><thead><tr><th>Sipariş</th><th>Durum</th><th>Ödeme</th><th>Teslimat</th><th>Tarih</th></tr></thead><tbody>{% for row in rows %}<tr><td><a href="{{ href('/yonetim/siparis/'~row.id) }}">{{ row.number }}</a></td><td>{{ row.status|status }}</td><td>{{ row.payment_status|status }}</td><td>{{ row.fulfillment_status|status }}</td><td>{{ row.created_at }}</td></tr>{% else %}<tr><td colspan="5">Henüz sipariş yok.</td></tr>{% endfor %}</tbody></table></div>{% endif %}
{% if section=='ayarlar' %}<form class="card form-stack narrow" data-api="/api/admin/settings"><h2>Hukuki satıcı bilgileri</h2><p>Geliştirici ve tasarımcı kimliği satıcı yerine kullanılamaz.</p>{% for key,label in {'seller.name':'Resmî satıcı unvanı','seller.taxNumber':'Vergi numarası','seller.address':'İşletme adresi','seller.supportEmail':'Destek e-postası','seller.phone':'İletişim telefonu','seller.bankAccount':'Banka hesap bilgisi'} %}<label>{{ label }}<input name="{{ key }}" value="{{ sellerSettings[key]??'' }}" maxlength="2000"></label>{% endfor %}<button class="button">Kaydet</button><p class="form-message" role="alert"></p></form>{% endif %}
{% if section=='entegrasyonlar' %}<div class="php-account-grid"><article class="card"><h2>Ödeme</h2><p>Test ortamında imzalı ödeme adaptörü çalışıyor.</p><p>Gerçek tahsilat: Kapalı.</p><p>Stripe işletme/kategori kabulü ve gerçek hesap bağlantısı bekleniyor.</p></article><article class="card"><h2>Gönderim ve fatura</h2><p>Taşıyıcı hesabı, tarifeler ve resmî fatura sağlayıcısı doğrulanmalıdır.</p><p>Sipariş belgesi resmî fatura yerine geçmez.</p></article></div>{% endif %}</section>{% endblock %}
