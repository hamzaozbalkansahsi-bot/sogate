{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/presentation-admin.twig | Açıklama: Kategori ağacı ve gerçek görsel galerisi için denetimli yönetim. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim') }}">Yönetime dön</a><h1>{{ title }}</h1><nav class="personal-tabs"><a href="{{ href('/yonetim/kategoriler') }}">Kategoriler</a><a href="{{ href('/yonetim/gorseller') }}">Görseller</a><a href="{{ href('/yonetim/tedarikci-katalogu') }}">Tedarikçi katalogları</a></nav>
{% if section=='categories' %}<form class="card form-stack" data-api="/api/admin/category-presentation" data-reload="true"><h2>Kategori ekle</h2><label>Bağlantı adı<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="120"></label><div class="field-grid"><label>Adı · Türkçe<input name="name" required maxlength="300"></label><label>Adı · English<input name="nameEn" required maxlength="300"></label></div><label>Üst kategori<select name="parent"><option value="">Ana kategori</option>{% for category in categoryRows %}<option value="{{ category.slug }}">{{ category.name }}</option>{% endfor %}</select></label><label>Sıra<input type="number" min="0" max="100000" name="sortOrder" value="0"></label><label class="php-check"><input type="checkbox" name="active" checked><span>Etkin</span></label><button class="button">Kategori ekle</button><p class="form-message" role="alert"></p></form><div class="presentation-category-list">{% for row in categoryRows %}<details class="card"><summary>{{ row.name }} · {{ row.active?'Etkin':'Kapalı' }}</summary><form class="form-stack" data-api="/api/admin/category-presentation" data-reload="true"><input type="hidden" name="slug" value="{{ row.slug }}"><label>Adı · Türkçe<input name="name" value="{{ row.name }}" required maxlength="300"></label><label>Adı · English<input name="nameEn" value="{{ row.name_en }}" required maxlength="300"></label><label>Üst kategori<select name="parent"><option value="">Ana kategori</option>{% for category in categoryRows %}{% if category.slug!=row.slug %}<option value="{{ category.slug }}" {{ category.slug==row.parent_slug?'selected':'' }}>{{ category.name }}</option>{% endif %}{% endfor %}</select></label><label>Sıra<input type="number" name="sortOrder" min="0" max="100000" value="{{ row.sort_order }}"></label><label>Görsel yolu<input name="image" value="{{ row.image??'' }}" placeholder="Görsel kütüphanesindeki yol"></label><label class="php-check"><input type="checkbox" name="active" {{ row.active?'checked':'' }}><span>Etkin</span></label><p class="small muted">Kapatılan kategorinin alt kategorileri ve yayındaki ürünleri de satışa kapatılır. Yeniden açmak ürünleri otomatik yayımlamaz.</p><button class="button">Değişiklikleri kaydet</button><p class="form-message" role="alert"></p></form></details>{% endfor %}</div>
{% else %}<div class="field-grid"><form class="card form-stack" method="post" enctype="multipart/form-data" action="{{ href('/api/admin/media-upload') }}"><h2>Görsel yükle</h2><input type="hidden" name="_csrf" value="{{ csrf }}"><label>JPEG, PNG veya WebP · en fazla4 MB<input type="file" name="file" accept="image/jpeg,image/png,image/webp" required></label><label>Kullanım hakkı / kaynak referansı<textarea name="rightsReference" required minlength="5" maxlength="2000" rows="3"></textarea></label><button class="button">Yükle</button><p class="small muted">Görseller özel depoda tutulur; ürüne veya kategoriye bağlandıklarında yayımlanır. Dosya adı ve fotoğrafın konum bilgisi saklanmaz.</p></form><div class="card"><h2>Galeride kullanılacak ürün</h2><form method="get" class="form-stack"><label>Ürün adıyla ara<input name="q" maxlength="100"></label><button class="button button-outline">Ara</button></form><form class="form-stack" data-api="/api/admin/product-media" data-reload="true"><input type="hidden" name="idempotencyKey"><input type="hidden" name="key" data-command-key><label>Ürün<select name="productId" required data-media-product><option value="">Ürün seçin</option>{% for product in products %}<option value="{{ product.id }}">{{ product.name }}</option>{% endfor %}</select></label><label>Seçenek<select name="variantId" data-media-variant><option value="">Bütün seçeneklerde göster</option></select></label><label>Yüklenmiş görsel<select name="path" required>{% for asset in assets %}<option value="{{ asset.path }}">{{ asset.width }}×{{ asset.height }} · {{ asset.path|slice(-16) }}</option>{% endfor %}</select></label><label>Açıklayıcı alternatif metin · Türkçe<input name="altTr" required maxlength="300"></label><label>Alternative text · English<input name="altEn" required maxlength="300"></label><label>Kullanım hakkı referansı<input name="rightsReference" minlength="5" maxlength="2000" required></label><label>Sıra<input name="sortOrder" type="number" min="0" max="100000" value="0"></label><button class="button">Galeriye ekle</button><p class="form-message" role="alert"></p></form></div></div><div class="media-library">{% for asset in assets %}<article class="card"><img src="{{ asset(asset.path) }}" alt="Yüklenen görsel önizlemesi" width="200" height="200" loading="lazy"><p class="small">{{ asset.rights_reference }}</p><code>{{ asset.path }}</code></article>{% endfor %}</div><h2>Bağlı galeri görselleri</h2>{% for media in mediaRows %}<article class="card"><p>{{ media.product_name }}{% if media.variant_name %} · {{ media.variant_name }}{% endif %}</p><p class="small">{{ media.alt_tr }}</p><form data-api="/api/admin/product-media" data-reload="true"><input type="hidden" name="action" value="remove"><input type="hidden" name="id" value="{{ media.id }}"><button class="button button-outline">Galeriden kaldır</button><p class="form-message" role="alert"></p></form></article>{% endfor %}{% endif %}</section>{% endblock %}
