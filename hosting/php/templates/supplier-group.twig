{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/supplier-group.twig | Açıklama: Siparişe bağlı dar alıcı bilgisi, gerçek dış teyit ve manuel kısmi sevk. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim/tedarikciler') }}">Tedarikçi gönderimleri</a><h1>{{ group.number }}</h1><p>{{ group.status|status }}</p><div class="php-account-grid"><article class="card"><h2>Teslimat bilgileri</h2>{% for key,label in {'fullName':'Alıcı','line1':'Adres','line2':'Adres devamı','city':'Şehir','postalCode':'Posta kodu','country':'Ülke','phone':'Telefon'} %}{% if group.address[key] is defined %}<p><strong>{{ label }}:</strong> {{ group.address[key] }}</p>{% endif %}{% endfor %}<p>Taşıyıcı: {{ group.snapshot.carrier }}</p><p>Dış sipariş referansı: {{ group.external_order_reference??'Teyit bekleniyor' }}</p></article>
{% if group.status=='ready' %}<form class="card form-stack" data-api="/api/admin/suppliers" data-reload="true"><h2>Dış sipariş teyidi</h2><input type="hidden" name="action" value="accept"><input type="hidden" name="groupId" value="{{ group.id }}"><input type="hidden" name="idempotencyKey"><label>Gerçek dış sipariş referansı<input name="reference" required minlength="5" maxlength="500"></label><p>Bu kayıt tedarikçiye otomatik sipariş veya müşteri bilgisi göndermez.</p><button class="button">Teyidi kaydet</button><p class="form-message" role="alert"></p></form>{% endif %}
{% if group.status in ['accepted','partially_shipped'] %}<form class="card form-stack" data-api="/api/admin/suppliers" data-reload="true"><h2>Manuel sevk</h2><input type="hidden" name="action" value="ship"><input type="hidden" name="groupId" value="{{ group.id }}"><input type="hidden" name="idempotencyKey"><label>Kalem<select name="variantId">{% for i in group.items %}{% if i.sent<i.quantity %}<option value="{{ i.variant_id }}">{{ i.sku }} · {{ i.quantity-i.sent }} adet kaldı</option>{% endif %}{% endfor %}</select></label><label>Sevk edilen adet<input name="quantity" type="number" min="1" max="1000000" required></label><label>Onaylı taşıyıcı<input name="carrier" value="{{ group.snapshot.carrier }}" readonly required></label><label>Gerçek takip numarası<input name="trackingNumber" minlength="5" maxlength="200" required></label><button class="button">Sevki kaydet</button><p class="form-message" role="alert"></p></form>{% endif %}</div>
<div class="card php-table-wrap"><table><thead><tr><th>Stok kodu</th><th>Ürün</th><th>Sipariş adedi</th><th>Sevk edilen</th></tr></thead><tbody>{% for i in group.items %}<tr><td>{{ i.sku }}</td><td>{{ i.name }}</td><td>{{ i.quantity }}</td><td>{{ i.sent }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
