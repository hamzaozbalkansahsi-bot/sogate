{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/cart.twig | Açıklama: Kalıcı sepet ve yeniden hesaplanan para özeti. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><h1>{{ title }}</h1>{% if cart.items|length %}<div class="php-checkout-grid"><div>{% for item in cart.items %}<article class="card php-cart-row"><img src="{{ asset(item.image) }}" alt="" width="100" height="110"><div><h2>{{ locale=='en'?item.productNameEn:item.productName }}</h2><p>{{ locale=='en'?item.variantNameEn:item.variantName }}</p><p class="price">{{ item.priceMinor|money }}</p><form data-api="/api/cart" data-reload="true" class="php-inline"><input type="hidden" name="variantId" value="{{ item.variantId }}"><label>{{ t('quantity') }}<input name="quantity" type="number" value="{{ item.quantity }}" min="0" max="99" required></label><button class="button button-outline">{{ t('update') }}</button><p class="form-message" role="alert"></p></form></div></article>{% endfor %}</div><aside class="card"><h2>{{ t('subtotal') }}</h2><p class="php-total">{{ cart.subtotalMinor|money }}</p><p class="small muted">{{ locale=='tr'?'Teslimat ve dahil vergi, ödeme öncesi özette gösterilir.':'Delivery and included tax are shown before payment.' }}</p><a class="button full" href="{{ href('/odeme') }}">{{ t('checkout') }}</a></aside></div>{% else %}<div class="card php-empty"><h2>{{ t('empty_cart') }}</h2><a class="button" href="{{ href('/urunler') }}">{{ t('continue') }}</a></div>{% endif %}</section>{% endblock %}
