{% extends 'layout.twig' %}{% block content %}<section class="section container"><h1>{{ title }}</h1><p id="cart-message" class="form-message" role="status" aria-live="polite"></p><div id="cart-undo" class="cart-undo" hidden><span>{{ locale=='tr'?'Sepetten kaldırıldı. 8 saniye içinde geri alabilirsiniz.':'Removed from cart. You can undo within 8 seconds.' }}</span><button id="cart-undo-button" type="button">{{ locale=='tr'?'Geri al':'Undo' }}</button></div>{% include '_cart-body.twig' %}</section>{% endblock %}
