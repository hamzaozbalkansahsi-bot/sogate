{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/lots-admin.twig | Açıklama: Gerçek lot bakiyesi ve kontrollü üretici geri çağırma kaydı. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim') }}">Yönetime dön</a><h1>Lot ve geri çağırma</h1>{% for row in rows %}<article class="card form-stack"><h2>{{ row.sku }} · {{ row.lot_number }}</h2><p>Satılabilir fiziksel: {{ row.on_hand??0 }} · Karantina: {{ row.quarantine??0 }}</p>{% if row.expires_at %}<p>Son kullanma: {{ row.expires_at }}</p>{% endif %}{% if row.recall_reference %}<p>Geri çağırma: {{ row.recall_reference }}</p>{% else %}<form class="form-stack" data-api="/api/admin/stock-management" data-reload="true"><input type="hidden" name="action" value="recall"><input type="hidden" name="lotId" value="{{ row.id }}"><input type="hidden" name="idempotencyKey"><label>Üretici geri çağırma referansı<textarea name="reference" minlength="10" maxlength="2000" required></textarea></label><button class="button button-outline">Geri çağır ve karantinaya ayır</button><p class="form-message" role="alert"></p></form>{% endif %}</article>{% else %}<div class="card"><p>Henüz lot kaydı yok. Lotlu ürünler satın alma mal kabulünden kaydedilir.</p></div>{% endfor %}</section>{% endblock %}
