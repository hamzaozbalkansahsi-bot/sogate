{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/checkout.twig | Açıklama: Ülke profilli adres, imzalı toplam ve ayrı sözleşme onayları. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><p class="eyebrow">SEXOGATE</p><h1>{{ title }}</h1>{% if testEnvironment %}<p class="document-status">{{ locale=='tr'?'Bu alanda gerçek ödeme alınmaz. Sipariş denemelerinde örnek iletişim ve adres bilgileri kullanın.':'No real payment is collected here. Use example contact and address details for trial orders.' }}</p>{% endif %}
<nav class="checkout-progress" aria-label="{{ locale=='tr'?'Sipariş adımları':'Checkout steps' }}"><ol>{% for label in [locale=='tr'?'İletişim ve adres':'Contact and address',locale=='tr'?'Teslimat':'Delivery',locale=='tr'?'Kontrol ve ödeme':'Review and payment'] %}<li><button type="button" data-checkout-go="{{ loop.index0 }}" {{ loop.first?'aria-current="step"':'' }}><span>{{ loop.index }}</span>{{ label }}</button></li>{% endfor %}</ol></nav>
<form data-api="/api/checkout" id="checkout-form" class="php-checkout-grid" data-cart="{{ cart.id }}" data-owner="{{ principal?principal.id:'guest' }}"><input type="hidden" name="locale" value="{{ locale }}"><input type="hidden" name="quoteToken" value="{{ quote.quoteToken }}"><input type="hidden" name="idempotencyKey"><div class="checkout-panels">
<fieldset class="card form-stack" data-checkout-step="0"><legend>{{ t('address') }}</legend><label>{{ t('email') }}<input name="email" type="email" autocomplete="email" required maxlength="254"></label><label>{{ t('country') }}<select name="country"><option value="TR">Türkiye</option></select></label><label>{{ t('currency') }}<select name="currency"><option value="TRY">TRY · ₺</option></select></label>{% for field in quote.profile.fields %}<label>{{ field.label[locale] }}<input name="{{ field.id }}" minlength="{{ field.minLength }}" maxlength="{{ field.maxLength }}" {{ field.required?'required':'' }} autocomplete="{{ field.id=='fullName'?'name':(field.id=='phone'?'tel':(field.id=='line1'?'street-address':(field.id=='postalCode'?'postal-code':'address-level2'))) }}"></label>{% endfor %}
<label class="php-check"><input type="checkbox" name="sameBilling" checked><span>{{ locale=='tr'?'Fatura adresim teslimat adresimle aynı.':'My billing and delivery addresses are the same.' }}</span></label><fieldset id="billing-address" class="form-stack" disabled hidden><legend>{{ locale=='tr'?'Fatura adresi':'Billing address' }}</legend><input type="hidden" name="billingCountry" value="TR">{% for field in quote.profile.fields %}{% if field.id!='phone' %}{% set billingKey='billing'~(field.id|slice(0,1)|upper)~(field.id|slice(1)) %}<label>{{ field.label[locale] }}<input name="{{ billingKey }}" minlength="{{ field.minLength }}" maxlength="{{ field.maxLength }}" {{ field.required?'required':'' }} autocomplete="billing {{ field.id=='fullName'?'name':(field.id=='line1'?'street-address':(field.id=='postalCode'?'postal-code':'address-level2')) }}"></label>{% endif %}{% endfor %}</fieldset><p class="small muted">{{ locale=='tr'?'Adres taslağı yalnız bu sekmede, en fazla 20 dakika hatırlanır. Ödeme bilgileri ve sözleşme onayları kaydedilmez.':'The address draft is remembered only in this tab for up to 20 minutes. Payment details and agreement confirmations are not saved.' }}</p><button class="button" type="button" data-checkout-next>{{ locale=='tr'?'Teslimata devam et':'Continue to delivery' }}</button></fieldset>
<fieldset class="card form-stack" data-checkout-step="1" hidden><legend>{{ locale=='tr'?'Teslimat bilgileri':'Delivery details' }}</legend><p>{{ locale=='tr'?'Siparişiniz aşağıdaki gönderim planıyla hazırlanır.':'Your order follows the dispatch plan below.' }}</p>{% for package in quote.packages %}<article class="delivery-option"><h2>{{ locale=='tr'?'Gönderi':'Package' }} {{ loop.index }}</h2><p>{{ package.shippingMinor|money(quote.currency) }}</p>{% if package.minDays is defined and package.maxDays is defined %}<p>{{ package.minDays }}–{{ package.maxDays }} {{ locale=='tr'?'gün hazırlık/taşıma aralığı':'days dispatch/transit range' }}</p>{% endif %}</article>{% endfor %}<p>{{ locale=='tr'?'Teslim koşulu':'Delivery term' }}: {{ quote.deliveryTerm }}</p><div class="checkout-actions"><button type="button" class="button button-outline" data-checkout-back>{{ t('previous') }}</button><button type="button" class="button" data-checkout-next>{{ locale=='tr'?'Siparişi kontrol et':'Review order' }}</button></div></fieldset>
<fieldset class="card form-stack" data-checkout-step="2" hidden><legend>{{ locale=='tr'?'Son kontrol':'Final review' }}</legend><div id="checkout-address-review"></div><p>{{ locale=='tr'?'Seçtiğiniz ürünleri, adresi ve toplam tutarı kontrol edin.':'Review your selected items, addresses and total.' }}</p>{% for item in cart.items %}{% if item.selected %}<div class="php-summary-row"><span>{{ locale=='en'?item.productNameEn:item.productName }} · {{ locale=='en'?item.variantNameEn:item.variantName }} × {{ item.quantity }}</span><span>{{ (item.priceMinor*item.quantity)|money }}</span></div>{% endif %}{% endfor %}
<div class="checkout-agreement-buttons">{% for agreement in agreements %}<button class="text-link" type="button" data-dialog-open="agreement-{{ agreement.kind }}" aria-controls="agreement-{{ agreement.kind }}" aria-expanded="false">{{ agreement.kind=='privacy'?(locale=='tr'?'Aydınlatma metnini oku':'Read the privacy notice'):(locale=='tr'?'Ön bilgilendirme ve satış koşullarını oku':'Read pre-contract information and sales terms') }}</button>{% endfor %}<a href="{{ href('/yasal/iade') }}" target="_blank" rel="noopener noreferrer">{{ locale=='tr'?'İade koşulları':'Returns policy' }}</a></div>
<label class="php-check"><input type="checkbox" name="privacyAccepted" required><span>{{ t('privacy_accept') }}</span></label><label class="php-check"><input type="checkbox" name="termsAccepted" required><span>{{ t('terms_accept') }}</span></label><div class="checkout-actions"><button type="button" class="button button-outline" data-checkout-back>{{ t('previous') }}</button><button class="button" type="submit">{{ t('pay') }}</button></div></fieldset><p class="form-message" role="alert"></p></div>
<aside class="card form-stack checkout-order-summary"><h2>{{ locale=='tr'?'Sipariş özeti':'Order summary' }}</h2><label>{{ t('coupon') }}<input name="couponCode" maxlength="60"></label><button type="button" id="refresh-quote" class="button button-outline">{{ t('quote') }}</button><div id="checkout-summary">{% for key,label in {'subtotalMinor':t('subtotal'),'shippingMinor':t('shipping'),'discountMinor':t('discount'),'taxMinor':t('tax'),'totalMinor':t('total')} %}<div class="php-summary-row {{ key=='totalMinor'?'php-total':'' }}"><span>{{ label }}</span><strong data-total="{{ key }}">{{ quote[key]|money(quote.currency) }}</strong></div>{% endfor %}</div></aside></form>
{% for agreement in agreements %}<dialog id="agreement-{{ agreement.kind }}" class="discovery-dialog agreement-dialog" aria-labelledby="agreement-title-{{ agreement.kind }}"><div class="drawer-heading"><h2 id="agreement-title-{{ agreement.kind }}">{{ agreement.title }}</h2><button type="button" data-dialog-close aria-label="{{ t('close') }}">×</button></div><p>{{ locale=='tr'?'Sürüm':'Version' }} {{ agreement.version }}{% if agreement.fixture %} · {{ locale=='tr'?'Test belge örneği':'Test document sample' }}{% endif %}</p><div class="information-prose">{{ agreement.body|nl2br }}</div></dialog>{% endfor %}</section>{% endblock %}
