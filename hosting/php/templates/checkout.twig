{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/checkout.twig | Açıklama: Ülke profilli adres, imzalı toplam ve ayrı sözleşme onayları. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><p class="eyebrow">SEXOGATE</p><h1>{{ title }}</h1>{% if testEnvironment %}<p class="card">{{ locale=='tr'?'Bu alanda gerçek ödeme alınmaz. Sipariş denemelerinde örnek iletişim ve adres bilgileri kullanın.':'No real payment is collected here. Use example contact and address details for trial orders.' }}</p>{% endif %}<form data-api="/api/checkout" id="checkout-form" class="php-checkout-grid"><div class="card form-stack"><h2>{{ t('address') }}</h2><input type="hidden" name="locale" value="{{ locale }}"><input type="hidden" name="quoteToken" value="{{ quote.quoteToken }}"><input type="hidden" name="idempotencyKey" value=""><label>{{ t('email') }}<input name="email" type="email" autocomplete="email" required maxlength="254"></label><label>{{ t('country') }}<select name="country"><option value="TR">{{ locale=='tr'?'Türkiye':'Türkiye' }}</option></select></label><label>{{ t('currency') }}<select name="currency"><option value="TRY">TRY · ₺</option></select></label>{% for field in quote.profile.fields %}<label>{{ field.label[locale] }}<input name="{{ field.id }}" minlength="{{ field.minLength }}" maxlength="{{ field.maxLength }}" {{ field.required?'required':'' }} autocomplete="{{ field.id=='fullName'?'name':(field.id=='phone'?'tel':(field.id=='line1'?'street-address':(field.id=='postalCode'?'postal-code':'address-level2'))) }}"></label>{% endfor %}</div><aside class="card form-stack"><h2>{{ t('order') }}</h2>{% for item in cart.items %}<div class="php-summary-row"><span>{{ locale=='en'?item.productNameEn:item.productName }} × {{ item.quantity }}</span><span>{{ (item.priceMinor*item.quantity)|money }}</span></div>{% endfor %}<label>{{ t('coupon') }}<input name="couponCode" maxlength="60"></label><button type="button" id="refresh-quote" class="button button-outline">{{ t('quote') }}</button><div id="checkout-summary"><div class="php-summary-row"><span>{{ t('subtotal') }}</span><span data-total="subtotalMinor">{{ quote.subtotalMinor|money }}</span></div><div class="php-summary-row"><span>{{ t('shipping') }}</span><span data-total="shippingMinor">{{ quote.shippingMinor|money }}</span></div><div class="php-summary-row"><span>{{ t('discount') }}</span><span data-total="discountMinor">{{ quote.discountMinor|money }}</span></div><div class="php-summary-row"><span>{{ t('tax') }}</span><span data-total="taxMinor">{{ quote.taxMinor|money }}</span></div><div class="php-summary-row php-total"><strong>{{ t('total') }}</strong><strong data-total="totalMinor">{{ quote.totalMinor|money }}</strong></div></div><p class="small">{{ quote.deliveryTerm }}</p><label class="php-check"><input type="checkbox" name="privacyAccepted" required><span>{{ t('privacy_accept') }} <a href="{{ href('/yasal/privacy') }}" target="_blank" rel="noopener">{{ t('privacy') }}</a></span></label><label class="php-check"><input type="checkbox" name="termsAccepted" required><span>{{ t('terms_accept') }} <a href="{{ href('/yasal/terms') }}" target="_blank" rel="noopener">{{ t('terms') }}</a></span></label><button class="button full" type="submit">{{ t('pay') }}</button><p class="form-message" role="alert"></p></aside></form></section>{% endblock %}
