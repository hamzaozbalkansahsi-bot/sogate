{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/_cards.twig | Açıklama: Gerçek katalogdan gelen ürün kartları. #}
<div class="product-grid">{% for product in products %}<article class="product-card"><a class="product-image-wrap" href="{{ href('/urun/'~product.slug) }}"><img src="{{ asset(product.image) }}" alt="{{ locale=='en'?product.name_en:product.name }}" width="460" height="520" loading="lazy"></a><button class="quick-view-button" type="button" data-quick-product="{{ product.slug }}">{{ locale=='tr'?'Hızlı incele':'Quick view' }}</button><div class="product-card-info"><p class="small muted">{{ product.brand }}</p><h3><a href="{{ href('/urun/'~product.slug) }}">{{ locale=='en'?product.name_en:product.name }}</a></h3>{% if product.variants|length %}<p class="price">{{ product.variants[0].display_price_minor is not null?product.variants[0].display_price_minor|money(product.variants[0].display_currency):(locale=='tr'?'Bu para biriminde fiyat yok':'Price unavailable in this currency') }}</p><p class="small muted">{{ product.variants[0].available>0?t('in_stock'):t('out_of_stock') }}</p>{% endif %}</div>{% include '_product-tools.twig' %}</article>{% else %}<div class="card php-empty"><p>{{ t('empty_catalog') }}</p></div>{% endfor %}</div>
