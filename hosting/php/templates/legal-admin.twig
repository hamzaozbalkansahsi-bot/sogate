{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/legal-admin.twig | Açıklama: Hukuk taslağı, işletme kontrolü, inceleme referansı ve yürürlüğe alma. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim') }}">Yönetime dön</a><h1>Hukuk metinleri</h1><p>İşletme bilgileri ve yetkili hukuk incelemesi tamamlanmadan metinler yürürlüğe alınamaz. Yeni sürüm, eski siparişin sözleşmesini değiştirmez.</p><form class="card form-stack" data-api="/api/admin/legal" data-reload="true"><h2>Yeni hukuk taslağı</h2><label>Belge<select name="kind">{% for key,label in {'privacy':'KVKK aydınlatma ve gizlilik','terms':'Ön bilgilendirme ve mesafeli satış','cookies':'Çerez politikası','membership':'Üyelik sözleşmesi','delivery':'Teslimat ve kargo','returns':'Cayma, iptal ve iade','defective-product':'Ayıplı ürün başvurusu','marketing-consent':'Ticari ileti izin metni','access-request':'İlgili kişi başvurusu'} %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></label><label>Dil<select name="locale"><option value="tr">Türkçe</option><option value="en">English</option></select></label><label>Başlık<input name="title" required maxlength="300"></label><label>Metin<textarea name="body" rows="10" required maxlength="30000"></textarea></label><button class="button">Taslak oluştur</button><p class="form-message" role="alert"></p></form>
{% for row in rows %}<article class="card form-stack"><h2>{{ row.title }} · {{ row.locale }} · Sürüm {{ row.version }}</h2><p>{{ row.status|status }}</p><details><summary>Metni incele</summary><div class="php-prose">{{ row.body|nl2br }}</div></details>{% if row.status=='draft' %}<form class="form-stack" data-api="/api/admin/legal" data-reload="true"><input type="hidden" name="action" value="approve"><input type="hidden" name="id" value="{{ row.id }}"><label>Yetkili hukuk incelemesi referansı<input name="reference" minlength="10" maxlength="2000" required></label><button class="button button-outline">İnceleme onayını kaydet</button><p class="form-message" role="alert"></p></form>{% elseif row.status=='approved' %}<form data-api="/api/admin/legal" data-reload="true"><input type="hidden" name="action" value="publish"><input type="hidden" name="id" value="{{ row.id }}"><button class="button">Onaylı sürümü yürürlüğe al</button><p class="form-message" role="alert"></p></form>{% endif %}</article>{% endfor %}</section>{% endblock %}
