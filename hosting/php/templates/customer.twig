{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/customer.twig | Açıklama: Sahiplikli adres, favori ve bağımsız iletişim tercihleri. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><h1>{{ title }}</h1><nav class="php-admin-nav"><a href="{{ href('/hesap') }}">{{ t('account') }}</a><a href="{{ href('/hesap/adresler') }}">{{ locale=='tr'?'Adreslerim':'My addresses' }}</a><a href="{{ href('/favoriler') }}">{{ locale=='tr'?'Favorilerim':'My favourites' }}</a><a href="{{ href('/hesap/tercihler') }}">{{ locale=='tr'?'İletişim ve gizlilik':'Communication and privacy' }}</a></nav>
{% if section=='addresses' %}<div class="php-account-grid"><div class="form-stack">{% for address in addresses %}<article class="card"><h2>{{ address.label }}</h2><p>{{ address.fields.fullName }}</p><p>{{ address.fields.line1 }}</p><p>{{ address.fields.postalCode }} · {{ address.fields.city }}</p><form data-api="/api/customer/addresses" data-reload="true"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="{{ address.id }}"><button class="button button-outline">{{ locale=='tr'?'Adresi kaldır':'Remove address' }}</button><p class="form-message" role="alert"></p></form></article>{% else %}<article class="card"><p>{{ locale=='tr'?'Kayıtlı adresiniz yok.':'You have no saved addresses.' }}</p></article>{% endfor %}</div><form class="card form-stack" data-api="/api/customer/addresses" data-reload="true"><h2>{{ locale=='tr'?'Adres ekle':'Add address' }}</h2><input type="hidden" name="country" value="TR">{% for name,label in {'label':(locale=='tr'?'Adres adı':'Address label'),'fullName':t('name'),'phone':(locale=='tr'?'Telefon':'Phone'),'line1':t('address'),'city':(locale=='tr'?'Şehir':'City'),'postalCode':(locale=='tr'?'Posta kodu':'Postal code')} %}<label>{{ label }}<input name="{{ name }}" required maxlength="{{ name=='line1'?300:100 }}" autocomplete="{{ name=='fullName'?'name':(name=='phone'?'tel':(name=='line1'?'street-address':'off')) }}"></label>{% endfor %}<button class="button">{{ t('save') }}</button><p class="form-message" role="alert"></p></form></div>{% endif %}
{% if section=='favorites' %}<div class="product-grid">{% for product in favorites %}<article class="product-card"><a href="{{ href('/urun/'~product.slug) }}"><img src="{{ asset(product.image) }}" alt="{{ locale=='en'?product.name_en:product.name }}" width="460" height="520"><h2>{{ locale=='en'?product.name_en:product.name }}</h2></a><form data-api="/api/customer/favorites" data-reload="true"><input type="hidden" name="productId" value="{{ product.id }}"><button class="button button-outline">{{ t('remove') }}</button><p class="form-message" role="alert"></p></form></article>{% else %}<article class="card"><p>{{ locale=='tr'?'Henüz favori ürününüz yok.':'You have no favourite products yet.' }}</p></article>{% endfor %}</div>{% endif %}
{% if section=='preferences' %}<form class="card form-stack narrow" data-api="/api/customer/preferences"><h2>{{ locale=='tr'?'İletişim ve gizlilik':'Communication and privacy' }}</h2><p>{{ locale=='tr'?'İzinler alışverişin şartı değildir. Tercihlerinizi istediğiniz zaman değiştirebilirsiniz.':'Consent is optional. You may change your preferences at any time.' }}</p>{% for key,label in {'marketing':(locale=='tr'?'Kampanya ve ürün haberleri almak istiyorum.':'I would like to receive marketing updates.'),'analytics':(locale=='tr'?'İsteğe bağlı analiz kullanımına izin veriyorum.':'I allow optional analytics.'),'privateNotifications':(locale=='tr'?'Bildirimlerimde ürün ayrıntıları görünmesin.':'Keep product details out of my notifications.')} %}<label class="php-check"><input type="checkbox" name="{{ key }}" {{ preferences[key]?'checked':'' }}><span>{{ label }}</span></label>{% endfor %}<button class="button">{{ t('save') }}</button><p class="form-message" role="alert"></p></form>{% endif %}</section>{% endblock %}
