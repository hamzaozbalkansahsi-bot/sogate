{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/content.twig | Açıklama: Yalnız yayımlanmış içerik sürümlerinin güvenli SSR görünümü. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container narrow"><p class="eyebrow">SEXOGATE</p><h1>{{ title }}</h1>{% for entry in entries %}<article class="card php-prose"><h2>{{ entry.title }}</h2>{% if entry.summary %}<p>{{ entry.summary }}</p>{% endif %}<div class="php-content-body">{{ entry.body|nl2br }}</div>{% if kind in ['guide','collection'] %}<a class="text-link" href="{{ href('/'~(kind=='guide'?'rehber':'koleksiyon')~'/'~entry.slug) }}">{{ locale=='tr'?'İçeriği aç':'Read more' }}</a>{% endif %}</article>{% else %}<article class="card"><p>{{ t('not_published') }}</p></article>{% endfor %}</section>{% endblock %}
