{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/footer.twig | Açıklama: Sosyal, alışveriş, destek ve ayrı sözleşme bağlantıları. #}
<footer class="php-footer"><div class="container">
 <div class="footer-intro"><a href="{{ href('/') }}" aria-label="SEXOGATE"><img src="{{ asset('/brand/app/logo-stacked-light.svg') }}" width="458" height="269" alt="SEXOGATE"></a><p>{{ t('adult_footer') }}</p><a class="footer-top" href="#main">{{ locale=='tr'?'Yukarı dön':'Back to top' }} <span aria-hidden="true">↑</span></a></div>
 <div class="footer-directory">
  <nav aria-labelledby="footer-shop"><h2 id="footer-shop">{{ locale=='tr'?'Koleksiyonları keşfet':'Explore collections' }}</h2><a href="{{ href('/urunler') }}">{{ t('all') }}</a><a href="{{ href('/koleksiyonlar') }}">{{ t('collections') }}</a>{% for category in categories %}<a href="{{ href('/kategori/'~category.slug) }}">{{ locale=='tr'?category.name:category.name_en }}</a>{% endfor %}<a href="{{ href('/site-haritasi') }}">{{ locale=='tr'?'Site haritası':'Site map' }}</a></nav>
  <nav aria-labelledby="footer-help"><h2 id="footer-help">{{ locale=='tr'?'Size yardımcı olalım':'Here to help' }}</h2><a href="{{ href('/blog') }}">Blog</a><a href="{{ href('/rehber') }}">{{ t('guide') }}</a><a href="{{ href('/sss') }}">{{ t('faq') }}</a><a href="{{ href('/yasal/iade') }}">{{ locale=='tr'?'İptal ve iade işlemleri':'Cancellations and returns' }}</a><a href="{{ href('/yasal/teslimat') }}">{{ locale=='tr'?'Teslimat ve kargo':'Delivery and shipping' }}</a><a href="{{ href('/iletisim') }}">{{ t('contact') }}</a></nav>
  <nav aria-labelledby="footer-legal"><h2 id="footer-legal">{{ locale=='tr'?'Gizlilik ve sözleşmeler':'Privacy and agreements' }}</h2><a href="{{ href('/yasal/kvkk') }}">{{ locale=='tr'?'KVKK aydınlatma metni':'Personal data notice' }}</a><a href="{{ href('/yasal/gizlilik') }}">{{ locale=='tr'?'Gizlilik politikası':'Privacy policy' }}</a><a href="{{ href('/yasal/mesafeli-satis') }}">{{ locale=='tr'?'Mesafeli satış sözleşmesi':'Distance sales agreement' }}</a><a href="{{ href('/yasal/iade') }}">{{ locale=='tr'?'Cayma ve iade koşulları':'Withdrawal and returns policy' }}</a><a href="{{ href('/yasal/cerez') }}">{{ locale=='tr'?'Çerez politikası':'Cookie policy' }}</a></nav>
  <div class="footer-connect"><h2>{{ locale=='tr'?'İletişimde kalalım':'Stay in touch' }}</h2><a class="footer-email" href="mailto:{{ footer.email }}">{{ footer.email }}</a><nav class="footer-social" aria-label="{{ locale=='tr'?'Sosyal medya':'Social media' }}">{% for social in footer.social %}<a href="{{ social.url }}" target="_blank" rel="noopener noreferrer">{% include '_social-icon.twig' with {network:social.name} only %}<span>{{ social.name }}</span><span class="social-arrow" aria-hidden="true">↗</span></a>{% endfor %}</nav></div>
 </div>
 <div class="footer-legal-line"><p>© {{ 'now'|date('Y') }} SEXOGATE. {{ t('copyright') }}</p><span>18+</span>{% if principal and principal.role!='customer' %}<a href="{{ href('/yonetim') }}">{{ t('admin') }}</a>{% endif %}</div>
</div></footer>
