{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/administration.twig | Açıklama: Kullanıcı/rol, güvenli iş kuyruğu ve işlem geçmişi görünümü. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container"><a class="text-link" href="{{ href('/yonetim') }}">Yönetime dön</a><h1>{{ section=='roles'?'Kullanıcı ve roller':(section=='jobs'?'İş kuyruğu':'İşlem geçmişi') }}</h1>{% if section=='roles' %}{% for row in rows %}<article class="card form-stack"><h2>{{ row.name }}</h2><p>{{ row.email }} · İki adımlı doğrulama: {{ row.twoFactorEnabled?'Açık':'Kurulum bekliyor' }}</p><form class="form-stack" data-api="/api/admin/roles" data-reload="true"><input type="hidden" name="userId" value="{{ row.id }}"><label>Rol<select name="role">{% for value,label in {'customer':'Müşteri','admin':'Yönetici','catalog':'Katalog','warehouse':'Depo / sevkiyat','support':'Müşteri hizmetleri','finance':'Finans','marketing':'Pazarlama'} %}<option value="{{ value }}" {{ row.role==value?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label><button class="button button-outline">Rolü değiştir ve oturumları iptal et</button><p class="form-message" role="alert"></p></form></article>{% else %}<article class="card"><p>Kullanıcı yok.</p></article>{% endfor %}{% else %}<div class="card php-table-wrap"><table><thead><tr><th>İşlem</th><th>Durum / tarih</th><th>Ayrıntı</th></tr></thead><tbody>{% for row in rows %}<tr>{% if section=='jobs' %}<td>{{ row.type=='order.confirmation'?'Sipariş bildirimi':(row.type=='reservation.expire'?'Rezervasyon süresi kontrolü':(row.type=='email.auth'?'Hesap bildirimi':(row.type=='stripe.event'?'Ödeme bildirimi':(row.type=='stripe.reconcile'?'Ödeme mutabakatı':(row.type=='payment.refund'?'Para iadesi':'Operasyon işi'))))) }}</td><td>{{ row.status|status }} · {{ row.attempts }}/{{ row.max_attempts }}</td><td>{% if row.last_error=='SMTP_NOT_CONFIGURED' %}E-posta bağlantısı yapılandırılmadı{% elseif row.last_error %}Bağlantı veya iş kuralı incelemesi gerekiyor{% endif %}{% if row.status=='failed' %}<form data-api="/api/admin/jobs" data-reload="true"><input type="hidden" name="id" value="{{ row.id }}"><button class="button button-outline">Yeniden kuyruğa al</button><p class="form-message" role="alert"></p></form>{% endif %}</td>{% else %}<td>{{ row.action }}</td><td>{{ row.created_at }}</td><td>{{ row.resource }}</td>{% endif %}</tr>{% else %}<tr><td colspan="3">Henüz kayıt yok.</td></tr>{% endfor %}</tbody></table></div>{% endif %}</section>{% endblock %}
