{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/product.twig | Açıklama: Gerçek varyant, teknik içerik ve sunucu sepeti. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container php-product"><div class="product-image-wrap"><img src="{{ asset(product.image) }}" width="650" height="720" alt="{{ title }}" fetchpriority="high"></div><div><p class="eyebrow">{{ product.brand }}</p><h1>{{ title }}</h1><p>{{ locale=='en'?product.description_en:product.description }}</p>{% if product.variants|length %}<form data-api="/api/cart" data-next="{{ href('/sepet') }}" class="form-stack card"><label>{{ t('variant') }}<select name="variantId" required>{% for variant in product.variants %}<option value="{{ variant.id }}" {{ variant.available<1?'disabled':'' }}>{{ locale=='en'?variant.name_en:variant.name }} · {{ variant.price_minor|money(variant.currency) }} · {{ variant.available>0?t('in_stock'):t('out_of_stock') }}</option>{% endfor %}</select></label><label>{{ t('quantity') }}<input type="number" name="quantity" value="1" min="1" max="99" required></label><button class="button full">{{ t('add') }}</button><p class="form-message" role="alert"></p></form>{% endif %}{% if principal %}<form data-api="/api/customer/favorites" class="form-stack"><input type="hidden" name="productId" value="{{ product.id }}"><input type="hidden" name="selected" value="true"><button class="button button-outline">{{ locale=='tr'?'Favorilerime ekle':'Save to favourites' }}</button><p class="form-message" role="alert"></p></form>{% endif %}<details open><summary>{{ t('details') }}</summary><p>{{ product.material }}</p>{% if product.manufacturer %}<p>{{ t('manufacturer') }}: {{ product.manufacturer }}</p>{% endif %}</details>{% if product.care %}<details><summary>{{ t('care') }}</summary><p>{{ product.care }}</p></details>{% endif %}{% if product.warnings %}<details><summary>{{ t('warnings') }}</summary><p>{{ product.warnings }}</p></details>{% endif %}</div></section>{% endblock %}
