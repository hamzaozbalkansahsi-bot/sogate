{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/product.twig | Açıklama: Gerçek varyant, teknik içerik ve sunucu sepeti. #}
{% extends 'layout.twig' %}{% block content %}
<section class="section container php-product" data-product-detail>
 <div class="product-gallery"><div class="product-image-wrap"><button type="button" class="product-zoom-button" data-image-zoom aria-label="{{ locale=='tr'?'Ürün görselini büyüt':'Enlarge product image' }}"><img data-gallery-main src="{{ asset(product.image) }}" width="650" height="720" alt="{{ title }}" fetchpriority="high"></button></div>
 {% if product.media|length>1 %}<div class="product-thumbnails" aria-label="{{ locale=='tr'?'Ürün görselleri':'Product images' }}">{% for image in product.media %}<button type="button" data-gallery-image="{{ asset(image.path) }}" data-gallery-alt="{{ locale=='tr'?image.alt_tr:image.alt_en }}" data-gallery-variant="{{ image.variant_id??'' }}" aria-label="{{ (locale=='tr'?'Görsel ':'Image ')~loop.index }}" aria-pressed="{{ loop.first?'true':'false' }}"><img src="{{ asset(image.path) }}" width="88" height="98" alt="" loading="lazy"></button>{% endfor %}</div>{% endif %}</div>
 <div class="product-information"><p class="eyebrow">{{ product.brand }}</p><h1>{{ title }}</h1><p>{{ locale=='en'?product.description_en:product.description }}</p>
 {% include '_product-tools.twig' %}
 {% if product.variants|length %}<form id="product-purchase" data-api="/api/cart" data-cart-feedback class="form-stack card"><input type="hidden" name="action" value="add"><p class="price" data-variant-price aria-live="polite"></p><label>{{ t('variant') }}<select name="variantId" required data-product-variant>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.display_price_minor is not null?variant.display_price_minor|money(variant.display_currency):(locale=='tr'?'Bu para biriminde fiyat yok':'Price unavailable in this currency') }}" data-sku="{{ variant.sku }}" data-stock="{{ variant.available>0?t('in_stock'):t('out_of_stock') }}" data-buyable="{{ variant.available>0?'true':'false' }}" {{ variant.available<1?'disabled':'' }}>{{ locale=='en'?variant.name_en:variant.name }} · {{ variant.display_price_minor is not null?variant.display_price_minor|money(variant.display_currency):'—' }} · {{ variant.available>0?t('in_stock'):t('out_of_stock') }}</option>{% endfor %}</select></label><p class="small muted" data-variant-meta></p><label>{{ t('quantity') }}<span class="quantity-control"><button type="button" data-quantity-step="-1" aria-label="{{ locale=='tr'?'Adedi azalt':'Decrease quantity' }}">−</button><input type="number" name="quantity" value="1" min="1" max="99" required><button type="button" data-quantity-step="1" aria-label="{{ locale=='tr'?'Adedi artır':'Increase quantity' }}">+</button></span></label><div class="product-buy-bar"><button class="button full" data-product-add>{{ t('add') }}</button></div><p class="form-message" role="alert"></p><a class="text-link" href="{{ href('/sepet') }}">{{ locale=='tr'?'Sepeti görüntüle':'View cart' }}</a></form>{% endif %}
 <details open><summary>{{ t('details') }}</summary><dl class="product-specifications">{% if product.material %}<dt>{{ locale=='tr'?'Malzeme':'Material' }}</dt><dd>{{ product.material }}</dd>{% endif %}{% if product.manufacturer %}<dt>{{ t('manufacturer') }}</dt><dd>{{ product.manufacturer }}</dd>{% endif %}{% if product.origin %}<dt>{{ locale=='tr'?'Menşe':'Origin' }}</dt><dd>{{ product.origin }}</dd>{% endif %}{% for key,value in product.attributes %}{% if value is not iterable and value is not same as(null) %}<dt>{{ key }}</dt><dd>{{ value }}</dd>{% endif %}{% endfor %}</dl></details>
 {% if product.care %}<details><summary>{{ t('care') }}</summary><p>{{ product.care }}</p></details>{% endif %}{% if product.warnings %}<details><summary>{{ t('warnings') }}</summary><p>{{ product.warnings }}</p></details>{% endif %}</div>
</section><section class="section container"><div class="product-share"><button class="button button-outline" type="button" data-share-product>{{ locale=='tr'?'Ürünü paylaş':'Share product' }}</button><p class="form-message" role="status"></p></div>{% if related|length %}<h2>{{ locale=='tr'?'Benzer ürünler':'Related products' }}</h2>{% include '_cards.twig' with {products:related} %}{% endif %}</section>{% endblock %}
