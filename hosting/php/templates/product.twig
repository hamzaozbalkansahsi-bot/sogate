{# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN | Dosya: hosting/php/templates/product.twig | Açıklama: Gerçek varyant, teknik içerik ve sunucu sepeti. #}
{% extends 'layout.twig' %}{% block content %}<section class="section container php-product"><div class="product-image-wrap"><button type="button" class="product-zoom-button" data-image-zoom aria-label="{{ locale=='tr'?'Ürün görselini büyüt':'Enlarge product image' }}"><img src="{{ asset(product.image) }}" width="650" height="720" alt="{{ title }}" fetchpriority="high"></button></div><div><p class="eyebrow">{{ product.brand }}</p><h1>{{ title }}</h1><p>{{ locale=='en'?product.description_en:product.description }}</p>{% if product.variants|length %}<form data-api="/api/cart" data-cart-feedback class="form-stack card"><input type="hidden" name="action" value="add"><label>{{ t('variant') }}<select name="variantId" required>{% for variant in product.variants %}<option value="{{ variant.id }}" {{ variant.available<1?'disabled':'' }}>{{ locale=='en'?variant.name_en:variant.name }} · {{ variant.price_minor|money(variant.currency) }} · {{ variant.available>0?t('in_stock'):t('out_of_stock') }}</option>{% endfor %}</select></label><label>{{ t('quantity') }}<span class="quantity-control"><button type="button" data-quantity-step="-1" aria-label="{{ locale=='tr'?'Adedi azalt':'Decrease quantity' }}">−</button><input type="number" name="quantity" value="1" min="1" max="99" required><button type="button" data-quantity-step="1" aria-label="{{ locale=='tr'?'Adedi artır':'Increase quantity' }}">+</button></span></label><div class="product-buy-bar"><button class="button full">{{ t('add') }}</button></div><p class="form-message" role="alert"></p><a class="text-link" href="{{ href('/sepet') }}">{{ locale=='tr'?'Sepeti görüntüle':'View cart' }}</a></form>{% endif %}{% if principal %}<form data-api="/api/customer/favorites" class="form-stack"><input type="hidden" name="productId" value="{{ product.id }}"><input type="hidden" name="selected" value="true"><button class="button button-outline">{{ locale=='tr'?'Favorilerime ekle':'Save to favourites' }}</button><p class="form-message" role="alert"></p></form>{% endif %}<details open><summary>{{ t('details') }}</summary><p>{{ product.material }}</p>{% if product.manufacturer %}<p>{{ t('manufacturer') }}: {{ product.manufacturer }}</p>{% endif %}</details>{% if product.care %}<details><summary>{{ t('care') }}</summary><p>{{ product.care }}</p></details>{% endif %}{% if product.warnings %}<details><summary>{{ t('warnings') }}</summary><p>{{ product.warnings }}</p></details>{% endif %}</div></section><section class="section container"><div class="product-share"><button class="button button-outline" type="button" data-share-product>{{ locale=='tr'?'Ürünü paylaş':'Share product' }}</button><p class="form-message" role="status"></p></div>{% if related|length %}<h2>{{ locale=='tr'?'Benzer ürünler':'Related products' }}</h2>{% include '_cards.twig' with {products:related} %}{% endif %}</section>{% endblock %}
