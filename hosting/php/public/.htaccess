# Proje: SEXOGATE | Geliştirici: PTYS Technoligess LLC | Tasarım: Hamza ÖZBALKAN
# Dosya: hosting/php/public/.htaccess | Açıklama: Yalnız test uygulamasının PHP yönlendirmesi.
Options -Indexes -MultiViews
DirectoryIndex index.php
<IfModule mod_headers.c>
Header always unset Content-Security-Policy
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
Header always set Cache-Control "private, no-store"
Header always set X-Robots-Tag "noindex, nofollow"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin"
</IfModule>
RewriteEngine On
RewriteRule ^app(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L]
