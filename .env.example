# Değer içermez. Yerel rastgele sırları npm run setup:local üretir.
# Geliştirme/test/staging/production kimliği ve uygulama origin/bind adresleri.
APP_ENV=
APP_URL=
APP_BIND_HOST=
# Ayrı uygulama ve izole test PostgreSQL bağlantıları; istemciye verilmez.
DATABASE_URL=
TEST_DATABASE_URL=
# Better Auth origin ve oturum/şifreleme sırrı.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# test yalnız development/test; stripe için ayrıca kabul ve güvenli anahtar gerekir.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
# Gelecek sağlayıcı adaptörleri için ayrılmıştır; şu an kullanılmaz.
PAYMENT_API_KEY=
PAYMENT_MERCHANT_ID=
# Stripe sunucu anahtarları. Publishable key mevcut hosted Checkout akışında kullanılmaz.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Boolean işaret tek başına gerçek işletme/kategori kabulünün kanıtı değildir.
STRIPE_BUSINESS_APPROVED=
LIVE_SALES_ENABLED=
# Özel origin ve başlık temizleyen gerçek proxy doğrulanmadan etkinleştirmeyin.
TRUSTED_PROXY_ENABLED=
TRUSTED_CLIENT_IP_HEADER=
# Kalıcı worker e-posta bağlantısı; eksikse gönderim başarı sayılmaz.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Yerel güvenli dosya alanı veya özel S3 uyumlu bucket.
STORAGE_PROVIDER=
STORAGE_LOCAL_PATH=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Kargo/fatura API anahtarları ayrılmıştır; gerçek API bağlantısı uygulanmış değildir.
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
INVOICE_PROVIDER=
INVOICE_API_KEY=
# Yerel restore provası için 32 baytlık hex anahtar; yedekten ayrı saklanır.
BACKUP_ENCRYPTION_KEY=
# Yalnız development/test yönetici oluşturma; canlı hesap açma komutu değildir.
ADMIN_SETUP_EMAIL=
ADMIN_SETUP_PASSWORD=
# Yerel PostgreSQL/Compose; PG_BIN pg_dump ve pg_restore çalıştırılabilir dizini.
LOCAL_DB_PASSWORD=
PG_BIN=
